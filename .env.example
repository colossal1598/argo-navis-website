# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it contains secret keys.
#
# THIS FILE IS FOR VITE / BUILD-TIME VARS ONLY (import.meta.env).
# Server-side secrets read via `cloudflare:workers`' `env` (SUPABASE_URL,
# SUPABASE_SECRET_KEY, TURNSTILE_SECRET_KEY, RESEND_API_KEY) are NOT
# available from this file during local dev — the Cloudflare adapter reads
# those from .dev.vars instead. See .dev.vars.example for that half.
# (Both files are usually kept in sync with the same values locally, but
# they are read by two different systems.)

# Cloudflare Turnstile site key — safe for browser exposure, inlined into
# the built client bundle by Vite. Must ALSO be set as a build-time
# "Environment variable" in Cloudflare Pages project settings (not just a
# Functions secret) or the widget will silently fail to render in prod.
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Meta (Facebook) Pixel ID — safe for browser exposure, inlined into the
# built client bundle by Vite. Build-time only, same as the Turnstile
# site key above: must ALSO be set as a build-time "Environment variable"
# in Cloudflare Pages project settings, or the pixel silently won't
# render (MetaPixel.astro renders nothing when this is unset — by design,
# so local dev never fires tracking). Find it in Meta Events Manager →
# Data Sources → your Pixel → Settings.
PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# ── The vars below are also used server-side (via cloudflare:workers env).
# They're listed here too so this file fully documents what api/leads.ts
# needs, but for LOCAL DEV they must be copied into .dev.vars (see
# .dev.vars.example) — astro dev will not read them from this file.

# Found in your Supabase project:  Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Found in your Supabase project:  Settings → API Keys → API Keys tab → Secret key
# Format: sb_secret_...  (NOT the legacy service_role JWT key)
# Use the secret key (not publishable) so the API route can insert without RLS restrictions.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# Cloudflare Turnstile secret key (server-side only)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Resend — transactional email (lead auto-reply + owner notification)
# Get your key at resend.com → API Keys
RESEND_API_KEY=re_your-api-key-here

# n8n lead webhook URL (server-side only). api/leads.ts POSTs every lead
# here directly from the Worker — the n8n side fans out to the owner's
# Telegram alert and the Meta Conversions API. This replaced the old
# Supabase pg_net DB trigger (single point of failure: a paused DB killed
# the webhook too). Keep this out of any client code — it must never be
# visible in the front end. Unset = the send is skipped.
N8N_LEAD_WEBHOOK_URL=https://your-n8n-host/webhook/your-lead-path

# NOTE: NOTIFICATION_EMAIL was previously listed here but is not read by
# any code — the owner notification address is hardcoded in
# src/pages/api/leads.ts ("jason@argo-navis.net"). Removed to keep this
# file accurate; wire it up as a real env var if that should change.
