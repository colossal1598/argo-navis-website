---
/*
  PROPS:
    heading      — title shown above the form
    subheading   — one-line description under the title
    source       — tag stored in the database so you know which page
                   the lead came from (e.g. "landing", "websites")
    fields       — array of form field configs (see default below)
                   override per-page to change what the form asks
    submitLabel  — text on the submit button (default: "Let's talk")
    reassurance  — small muted line under the button
                   e.g. "No pitch. No pressure. Just a conversation."
    locale       — "en" | "he" (default "en"). Picks the WhatsApp CTA's
                   link/copy defaults from src/lib/whatsapp.ts (Task 4.5)
                   — pass "he" on every HE page; EN pages can omit it.
                   Override whatsappDividerText/whatsappFormLabel/
                   whatsappSuccessLabel individually if a page needs
                   different phrasing than the shared default.
*/
import { type SiteLocale, whatsappCopy, whatsappHref } from "../lib/whatsapp";

interface FieldConfig {
  id:          string;
  label:       string;
  type:        "text" | "email" | "url" | "textarea";
  placeholder: string;
  required:    boolean;
}

interface Props {
  heading?:     string;
  subheading?:  string;
  source?:      string;
  fields?:      FieldConfig[];
  submitLabel?: string;
  reassurance?: string;
  loadingText?: string;
  successText?: string;
  turnstileHint?: string;
  challengeErrorText?: string;
  contactMethodLabel?: string;
  contactMethods?: ContactMethodConfig[];
  contactDetailsLabel?: string;
  contactDetailsRequiredText?: string;
  contactDetailsPlaceholders?: Partial<Record<ContactMethodConfig["id"], string>>;
  locale?: SiteLocale;
  whatsappDividerText?: string;
  whatsappFormLabel?: string;
  whatsappSuccessLabel?: string;
}

interface ContactMethodConfig {
  id: "whatsapp" | "telegram" | "phone" | "email";
  label: string;
}

/*
  DEFAULT FIELDS — used on the homepage.
  Pages that need different fields pass their own array via the
  fields prop (see websites/index.astro for an example).
*/
const defaultFields: FieldConfig[] = [
  {
    id:          "name",
    label:       "Your name",
    type:        "text",
    placeholder: "Your name",
    required:    true,
  },
  {
    id:          "email",
    label:       "Email",
    type:        "email",
    placeholder: "you@company.com",
    required:    true,
  },
  {
    id:          "website",
    label:       "Website",
    type:        "url",
    placeholder: "yoursite.com (if you have one)",
    required:    false,
  },
  {
    id:          "message",
    label:       "What do you need?",
    type:        "textarea",
    placeholder: "Tell us what's going on",
    required:    true,
  },
];

const defaultContactMethods: ContactMethodConfig[] = [
  { id: "email", label: "Email" },
  { id: "phone", label: "Phone" },
  { id: "telegram", label: "Telegram" },
  { id: "whatsapp", label: "WhatsApp" },
];

const defaultContactDetailsPlaceholders: Record<ContactMethodConfig["id"], string> = {
  email: "",
  phone: "Your phone number (with country code)",
  telegram: "Your Telegram @username",
  whatsapp: "Your WhatsApp number (with country code)",
};

const contactMethodIcons = {
  whatsapp: "whatsapp",
  telegram: "telegram",
  phone: "phone",
  email: "email",
} as const;

const methodNeedsDetails = {
  email: false,
  phone: true,
  telegram: true,
  whatsapp: true,
} as const;

const methodDetailsRequired = "Contact details are required for this contact method.";

const {
  heading     = "Ready to stop leaving money on the table?",
  subheading  = "Tell us what you're working with. We'll take it from there.",
  source      = "landing",
  fields      = defaultFields,
  submitLabel = "Let's talk",
  reassurance = "No pitch. No pressure. Just a conversation.",
  loadingText = "Sending...",
  successText = "Got it — we'll be in touch.",
  turnstileHint = "Bot protection is not configured yet.",
  challengeErrorText = "Please complete the verification challenge.",
  contactMethodLabel = "Preferred contact method",
  contactMethods = defaultContactMethods,
  contactDetailsLabel = "Contact details",
  contactDetailsRequiredText = methodDetailsRequired,
  contactDetailsPlaceholders = defaultContactDetailsPlaceholders,
  locale = "en" as SiteLocale,
  whatsappDividerText = whatsappCopy[locale].dividerText,
  whatsappFormLabel = whatsappCopy[locale].formLabel,
  whatsappSuccessLabel = whatsappCopy[locale].successLabel,
} = Astro.props;

// Build-time URL-encoding (Task 4.5) — never hand-paste percent-encoding.
const whatsappLink = whatsappHref(locale);

const normalizedContactMethods = contactMethods;
const mergedContactDetailsPlaceholders = {
  ...defaultContactDetailsPlaceholders,
  ...(contactDetailsPlaceholders ?? {}),
};
const defaultContactMethod = normalizedContactMethods[0]?.id ?? "email";
const defaultMethodNeedsDetails = methodNeedsDetails[defaultContactMethod];

const contactMethodMeta = normalizedContactMethods.map((method) => ({
  id: method.id,
  label: method.label,
  icon: contactMethodIcons[method.id],
  detailsPlaceholder: mergedContactDetailsPlaceholders[method.id],
}));

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
/*
  Launch audit fix (Task 4.1, Critical): this used to be `import.meta.env.PROD`
  alone — so if PUBLIC_TURNSTILE_SITE_KEY is ever unset in production, no
  widget renders (see the turnstileSiteKey ? ... : turnstileHint branch below)
  but the form still demanded a challenge token that could never be produced,
  permanently blocking every lead on the site. Now only requires the
  challenge when a site key actually exists to render one — mirrors the
  matching server-side fix in api/leads.ts.
*/
const turnstileRequired = import.meta.env.PROD && Boolean(turnstileSiteKey);
---

<section id="contact" class="bg-surface-950 px-6 py-section-lg">
  <div class="mx-auto max-w-xl">

    <!-- Heading — left-aligned to feel less like a marketing push -->
    <div class="mb-10">
      <h2 class="text-3xl font-bold text-text-primary">{heading}</h2>
      {subheading && <p class="mt-3 text-text-muted">{subheading}</p>}
    </div>

    <!--
      THE FORM — lightweight, no heavy card or box around it.
      Inputs sit directly on the page background for a clean feel.
    -->
    <form id="lead-form" novalidate class="space-y-6">

      <!-- Hidden source tag — automatic, no need to touch -->
      <input type="hidden" name="source" value={source} />
      <input type="hidden" id="contact-method-input" name="contact_method" value={defaultContactMethod} />

      {fields.map(field => (
        <div>
          <label for={field.id} class="field-label">
            {field.label}
            {/*
              Required-asterisk color audit fix: text-brand-400 measured
              ~3.07:1 against the light-theme surface (fails WCAG AA's
              4.5:1). text-text-primary is the theme-mapped body-text
              token — it's always near-max contrast against the surface
              in both themes (checked: ~19:1 dark, ~18:1 light) rather
              than a single fixed hex that only works in one theme.
            */}
            {field.required && <span class="ms-1 font-bold text-text-primary">*</span>}
          </label>

          {field.type === "textarea" ? (
            <textarea
              id={field.id}
              name={field.id}
              placeholder={field.placeholder}
              required={field.required}
              rows={5}
              class="input"
            />
          ) : (
            <input
              type={field.type}
              id={field.id}
              name={field.id}
              placeholder={field.placeholder}
              required={field.required}
              class="input"
            />
          )}
        </div>
      ))}

      <!--
        CONTACT METHOD BUTTONS — one selected value is stored in hidden input.
        Keep this list short so selection is quick on mobile.
      -->
      <div>
        <p class="field-label">{contactMethodLabel}</p>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          {contactMethodMeta.map((method, index) => (
            <button
              type="button"
              data-contact-method={method.id}
              class:list={[
                /* min-h-11 (44px) audit fix: px-3/py-2/text-xs alone was
                   under the 44px touch-target minimum. min-h-11 sets a
                   floor without changing padding/border/font, so the
                   visual style is identical, just tall enough to tap. */
                "contact-method-btn inline-flex min-h-11 items-center justify-center gap-2 rounded-sm border border-border-subtle px-3 py-2 text-xs font-medium text-text-muted transition-colors hover:border-brand-500/60 hover:text-text-primary focus-ring",
                index === 0 && "border-brand-500/60 bg-brand-500/5 font-semibold text-text-primary",
              ]}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {method.icon === "whatsapp" && (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20 11.8a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.8zm-8-6.3a6.3 6.3 0 0 0-5.4 9.5l.2.3-.8 2.4 2.5-.8.2.1A6.3 6.3 0 1 0 12 5.5zm3.4 8c-.2-.1-1.3-.6-1.5-.7-.2-.1-.4-.1-.5.1-.1.2-.6.7-.7.8-.1.1-.3.1-.5 0a5.2 5.2 0 0 1-1.5-.9 5.8 5.8 0 0 1-1.1-1.3c-.1-.2 0-.3.1-.4l.3-.4.2-.3c.1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.3-.3-.5-.3h-.4c-.1 0-.4 0-.6.3s-.8.7-.8 1.8.8 2.1.9 2.2c.1.1 1.6 2.5 4 3.4.5.2.8.3 1.1.4.5.1 1 .1 1.4.1.4-.1 1.3-.5 1.5-1s.2-.9.1-1-.2-.2-.4-.3z" />
                </svg>
              )}
              {method.icon === "telegram" && (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M21.5 4.6c.3-1.2-.5-1.7-1.5-1.3L3.5 9.6c-1.1.4-1.1 1 .2 1.4l4.2 1.3 9.7-6.1c.5-.3.9-.1.5.2l-7.9 7.1-.3 4.6c.4 0 .6-.2.9-.4l2.1-2 4.4 3.3c.8.4 1.4.2 1.6-.8l2.6-12.6z" />
                </svg>
              )}
              {method.icon === "phone" && (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 11.2 19a19.4 19.4 0 0 1-6-6 19.8 19.8 0 0 1-2.9-8.6A2 2 0 0 1 4.2 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.8 2.6a2 2 0 0 1-.4 2l-1.2 1.2a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2-.4c.8.4 1.7.7 2.6.8A2 2 0 0 1 22 16.9z" />
                </svg>
              )}
              {method.icon === "email" && (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M3 7l9 6 9-6" />
                </svg>
              )}
              <span>{method.label}</span>
            </button>
          ))}
        </div>
      </div>

      <!--
        Contact details field appears for non-email methods. Launch audit
        fix (Task 4.1, High): had no accessible name (placeholder only,
        which isn't a reliable name for assistive tech and disappears on
        input) — added a visually-hidden label, kept in sync with the
        selected method by applyContactMethodState() below (same place
        that already updates the placeholder for the same reason).
      -->
      <div id="contact-details-wrap" class:list={[!defaultMethodNeedsDetails && "hidden"]}>
        <label for="contact-details-input" class="sr-only">{contactDetailsLabel}</label>
        <input
          id="contact-details-input"
          name="contact_details"
          type="text"
          value=""
          placeholder={contactMethodMeta.find(m => m.id === defaultContactMethod)?.detailsPlaceholder}
          required={defaultMethodNeedsDetails}
          class="input"
        />
      </div>

      <div class="space-y-2">
        {turnstileSiteKey ? (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="auto"
          ></div>
        ) : (
          <p class="text-sm text-text-muted">
            {turnstileHint}
          </p>
        )}
      </div>

      <!--
        Error box — shown by JS on API error. Launch audit fixes
        (Task 4.1): `.form-error-text` replaces a bare `text-red-400`
        utility, which measured ~2.65:1 against the light-theme surface
        (fails AA) — same fixed-hex-only-checked-in-dark-theme bug
        already fixed for badges/chips/prose links, just missed here
        (see global.css). `role="alert"` announces the message to
        screen readers the moment it appears (WCAG 4.1.3) — it wasn't
        announced at all before.
      -->
      <p id="form-error" role="alert" class="hidden text-sm form-error-text"></p>

      <div>
        <!-- SUBMIT BUTTON — token button classes, same style as the hero CTA for consistency. -->
        <button type="submit" id="submit-btn" class="btn btn-primary btn-lg">
          {submitLabel}
        </button>

        <!--
          REASSURANCE LINE — small muted text under the button.
          Change via the reassurance prop. Delete the line in the
          prop if you don't want it.
        -->
        {reassurance && (
          <p class="mt-3 text-sm text-text-muted">{reassurance}</p>
        )}
      </div>

      <!--
        WHATSAPP CTA (below form, Task 4.5) — a quiet divider + secondary
        button, last in the form so it hides together with the form once
        success shows (the success state below has its own instance with
        "speed things up" framing instead). `.btn-secondary` (not a new
        green token) keeps this inside the existing design-token system —
        no ad-hoc color for a one-off button. `target="_blank" rel="noopener"`,
        no preventDefault anywhere in the click handler (see script below)
        so the WhatsApp navigation is never blocked or delayed by tracking.
      -->
      <div class="flex items-center gap-3 pt-2">
        <span class="h-px flex-1 bg-border-subtle" aria-hidden="true"></span>
        <span class="text-xs text-text-muted">{whatsappDividerText}</span>
        <span class="h-px flex-1 bg-border-subtle" aria-hidden="true"></span>
      </div>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener"
        data-whatsapp-cta="form"
        class="btn btn-secondary btn-md"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20 11.8a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.8zm-8-6.3a6.3 6.3 0 0 0-5.4 9.5l.2.3-.8 2.4 2.5-.8.2.1A6.3 6.3 0 1 0 12 5.5zm3.4 8c-.2-.1-1.3-.6-1.5-.7-.2-.1-.4-.1-.5.1-.1.2-.6.7-.7.8-.1.1-.3.1-.5 0a5.2 5.2 0 0 1-1.5-.9 5.8 5.8 0 0 1-1.1-1.3c-.1-.2 0-.3.1-.4l.3-.4.2-.3c.1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.3-.3-.5-.3h-.4c-.1 0-.4 0-.6.3s-.8.7-.8 1.8.8 2.1.9 2.2c.1.1 1.6 2.5 4 3.4.5.2.8.3 1.1.4.5.1 1 .1 1.4.1.4-.1 1.3-.5 1.5-1s.2-.9.1-1-.2-.2-.4-.3z" />
        </svg>
        {whatsappFormLabel}
      </a>

    </form>

    <!--
      Success message — revealed by JS after a 200 response.
      `role="status"` (Task 4.1 launch audit fix) announces it to
      screen readers when it appears — it wasn't announced before.
    -->
    <div id="form-success" role="status" class="hidden mt-6">
      <p class="text-lg font-semibold text-text-primary">{successText}</p>

      <!-- WHATSAPP CTA (success state, Task 4.5) — "speed things up" framing, same link/tracking as the form's instance above. -->
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener"
        data-whatsapp-cta="success"
        class="btn btn-secondary btn-md mt-4"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20 11.8a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.8zm-8-6.3a6.3 6.3 0 0 0-5.4 9.5l.2.3-.8 2.4 2.5-.8.2.1A6.3 6.3 0 1 0 12 5.5zm3.4 8c-.2-.1-1.3-.6-1.5-.7-.2-.1-.4-.1-.5.1-.1.2-.6.7-.7.8-.1.1-.3.1-.5 0a5.2 5.2 0 0 1-1.5-.9 5.8 5.8 0 0 1-1.1-1.3c-.1-.2 0-.3.1-.4l.3-.4.2-.3c.1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.3-.3-.5-.3h-.4c-.1 0-.4 0-.6.3s-.8.7-.8 1.8.8 2.1.9 2.2c.1.1 1.6 2.5 4 3.4.5.2.8.3 1.1.4.5.1 1 .1 1.4.1.4-.1 1.3-.5 1.5-1s.2-.9.1-1-.2-.2-.4-.3z" />
        </svg>
        {whatsappSuccessLabel}
      </a>
    </div>

  </div>
</section>

{turnstileSiteKey && (
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}

<script define:vars={{ loadingText, submitLabel, turnstileRequired, challengeErrorText, contactDetailsRequiredText, methodNeedsDetails, mergedContactDetailsPlaceholders, source }}>
  const form       = document.getElementById("lead-form");
  const btn        = document.getElementById("submit-btn");
  const errorBox   = document.getElementById("form-error");
  const successBox = document.getElementById("form-success");
  const contactMethodInput = document.getElementById("contact-method-input");
  const contactMethodButtons = document.querySelectorAll(".contact-method-btn");
  const contactDetailsWrap = document.getElementById("contact-details-wrap");
  const contactDetailsInput = document.getElementById("contact-details-input");

  function applyContactMethodState(method) {
    const needsDetails = Boolean(methodNeedsDetails?.[method]);
    if (!contactDetailsWrap || !contactDetailsInput) return;

    contactDetailsWrap.classList.toggle("hidden", !needsDetails);
    contactDetailsInput.required = needsDetails;
    contactDetailsInput.placeholder = mergedContactDetailsPlaceholders?.[method] ?? "";

    if (!needsDetails) {
      contactDetailsInput.value = "";
    }
  }

  // Sync visible selected button with hidden input value sent to the API.
  contactMethodButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const method = button.getAttribute("data-contact-method");
      if (!method || !contactMethodInput) return;

      contactMethodInput.value = method;
      applyContactMethodState(method);
      contactMethodButtons.forEach((btnEl) => {
        btnEl.classList.remove("border-brand-500/60", "bg-brand-500/5", "font-semibold", "text-text-primary");
        btnEl.classList.add("border-border-subtle", "text-text-muted");
        btnEl.setAttribute("aria-pressed", "false");
      });
      button.classList.add("border-brand-500/60", "bg-brand-500/5", "font-semibold", "text-text-primary");
      button.classList.remove("border-border-subtle", "text-text-muted");
      button.setAttribute("aria-pressed", "true");
    });
  });

  if (contactMethodInput?.value) {
    applyContactMethodState(contactMethodInput.value);
  }

  /*
    META TRACKING (Task 4.4) — best-effort only, never allowed to affect
    the visible submit flow. Every function here is wrapped so a cookie
    read failing, fbq being undefined (pixel not configured/blocked by
    the visitor), or any other tracking hiccup can never block or error
    the actual lead submission.
  */
  function readCookie(name) {
    const escaped = name.replace(/[.$?*|{}()[\]\\/+^]/g, "\\$&");
    const match = document.cookie.match(new RegExp("(?:^|; )" + escaped + "=([^;]*)"));
    return match ? decodeURIComponent(match[1]) : null;
  }

  // _fbp is set automatically by the Meta Pixel base script once it loads
  // (fb.1.<timestamp>.<random>) — just read it, never construct it.
  function getFbp() {
    try {
      return readCookie("_fbp");
    } catch {
      return null;
    }
  }

  // _fbc is also set automatically by the pixel when a visitor arrives
  // via an ad click, but a visitor can submit before the pixel finishes
  // loading (or with the pixel unconfigured/blocked) — fall back to
  // building it from the fbclid URL param per Meta's documented format.
  function getFbc() {
    try {
      const cookie = readCookie("_fbc");
      if (cookie) return cookie;
      const fbclid = new URLSearchParams(window.location.search).get("fbclid");
      if (!fbclid) return null;
      return `fb.1.${Date.now()}.${fbclid}`;
    } catch {
      return null;
    }
  }

  function trackLead(eventId) {
    try {
      const fbq = globalThis.fbq;
      if (typeof fbq === "function") {
        fbq("track", "Lead", { content_name: source }, { eventID: eventId });
      }
    } catch {
      // Tracking must never surface an error to the visitor — silent no-op.
    }
  }

  // WHATSAPP CTA CLICK TRACKING (Task 4.5) — guarded exactly like trackLead
  // above: silent no-op when fbq is undefined/blocked. Never calls
  // preventDefault and does nothing async, so the wa.me navigation
  // (target="_blank") is never blocked or delayed by tracking.
  function trackContact() {
    try {
      const fbq = globalThis.fbq;
      if (typeof fbq === "function") {
        fbq("track", "Contact");
      }
    } catch {
      // Tracking must never surface an error to the visitor — silent no-op.
    }
  }

  document.querySelectorAll("[data-whatsapp-cta]").forEach((link) => {
    link.addEventListener("click", trackContact);
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    btn.disabled    = true;
    btn.textContent = loadingText;
    errorBox.classList.add("hidden");

    const formData = new FormData(form);
    const token = formData.get("cf-turnstile-response");
    const selectedMethod = String(formData.get("contact_method") ?? "email");
    const methodDetail = String(formData.get("contact_details") ?? "").trim();

    if (selectedMethod !== "email" && !methodDetail) {
      errorBox.textContent = contactDetailsRequiredText;
      errorBox.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = submitLabel;
      return;
    }

    if (!token && turnstileRequired) {
      errorBox.textContent = challengeErrorText;
      errorBox.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = submitLabel;
      return;
    }

    const data = Object.fromEntries(formData);

    // Generated fresh per submit — shared with the fbq('track','Lead', ...)
    // call below so Meta can dedup this browser event against the
    // server-side CAPI event the owner's n8n workflow sends for the same
    // row (same event_id on both sides is what dedup keys off).
    const metaEventId = crypto.randomUUID();
    data.meta_event_id = metaEventId;
    data.fbc = getFbc();
    data.fbp = getFbp();

    try {
      const res  = await fetch("/api/leads", {
        method:  "POST",
        headers: { "Content-Type": "application/json" },
        body:    JSON.stringify(data),
      });
      const json = await res.json();

      if (res.ok) {
        form.classList.add("hidden");
        successBox.classList.remove("hidden");
        // Fire the Lead conversion only on confirmed success — never on
        // click, never speculatively — so ad-platform reporting matches
        // real saved leads, not just form-submit attempts.
        trackLead(metaEventId);
      } else {
        errorBox.textContent = json.error ?? "Something went wrong.";
        errorBox.classList.remove("hidden");
        btn.disabled    = false;
        btn.textContent = submitLabel;
        const turnstileApi = globalThis.turnstile;
        if (turnstileApi && typeof turnstileApi.reset === "function") {
          turnstileApi.reset();
        }
      }
    } catch {
      errorBox.textContent = "Network error — please try again.";
      errorBox.classList.remove("hidden");
      btn.disabled    = false;
      btn.textContent = submitLabel;
      const turnstileApi = globalThis.turnstile;
      if (turnstileApi && typeof turnstileApi.reset === "function") {
        turnstileApi.reset();
      }
    }
  });
</script>
