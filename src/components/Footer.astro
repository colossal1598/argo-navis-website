---
import { type SiteLocale, withLocale } from "../lib/locale";

interface Props {
  locale?: SiteLocale;
}

const { locale = "en" } = Astro.props;

/*
  FOOTER COPY — every user-facing string lives here, keyed by locale, so
  nothing is hard-coded inline in the markup (including the legal line,
  which previously stayed in English even on the Hebrew page).
*/
const copy: Record<SiteLocale, {
  servicesHeading: string;
  companyHeading:  string;
  guidesHeading:   string;
  systems:         string;
  automations:     string;
  websites:        string;
  aiAgents:        string;
  contact:         string;
  tagline:         string;
  rights:          string;
  lpSpreadsheets:      string;
  lpAiAgents:          string;
  lpConnectedSystems:  string;
  lpMissedCalls:       string;
}> = {
  en: {
    servicesHeading: "Services",
    companyHeading:  "Company",
    guidesHeading:   "Guides",
    systems:         "Systems",
    automations:     "Automations",
    websites:        "Websites",
    aiAgents:        "AI Agents",
    contact:         "Contact",
    tagline:         "We build systems and sites that generate leads and scale your business.",
    rights:          "All rights reserved.",
    lpSpreadsheets:      "Off the Spreadsheets",
    lpAiAgents:          "Custom AI Agents",
    lpConnectedSystems:  "Connected Systems",
    lpMissedCalls:       "Missed Calls",
  },
  he: {
    servicesHeading: "שירותים",
    companyHeading:  "חברה",
    guidesHeading:   "מדריכים",
    systems:         "מערכות",
    automations:     "אוטומציות",
    websites:        "אתרים",
    aiAgents:        "סוכני AI",
    contact:         "דברו איתנו",
    tagline:         "אנחנו בונים מערכות ואתרים שמביאים לידים ומקדמים את העסק שלכם.",
    rights:          "כל הזכויות שמורות.",
    lpSpreadsheets:      "לצאת מהגיליונות",
    lpAiAgents:          "AI מותאם אישית",
    lpConnectedSystems:  "לחבר מערכות",
    lpMissedCalls:       "שיחות שלא מפספסים",
  },
};
const t = copy[locale];

/*
  ROUTE EXISTENCE CHECK — same idea as Navigation.astro: some service
  pages are built EN-first, so a HE page shouldn't link to a /he
  counterpart that doesn't exist yet.
*/
const pageFiles = import.meta.glob("../pages/**/*.astro");
const existingRoutes = new Set(
  Object.keys(pageFiles).map((file) => {
    const route = file
      .replace("../pages", "")
      .replace(/\/index\.astro$/, "")
      .replace(/\.astro$/, "");
    return route === "" ? "/" : route;
  })
);
function routeExists(href: string): boolean {
  const path = href.split("#")[0] || "/";
  return existingRoutes.has(path);
}

/*
  GUIDES COLUMN — restrained main-site link to the otherwise-orphaned
  landing pages (LandingLayout has no nav/footer of its own by design —
  see lp-pattern.md). Filtered the same way as the Services column, so
  it simply doesn't render at all on a locale with no /lp pages yet
  (self-healing once /he/lp/* ships) instead of showing an empty column.
*/
const lpLinks = [
  { label: t.lpSpreadsheets, href: withLocale("/lp/spreadsheets", locale) },
  { label: t.lpAiAgents, href: withLocale("/lp/ai-agents", locale) },
  { label: t.lpConnectedSystems, href: withLocale("/lp/connected-systems", locale) },
  { label: t.lpMissedCalls, href: withLocale("/lp/missed-calls", locale) },
].filter((link) => routeExists(link.href));

/*
  FOOTER COLUMNS — each object is a column in the footer.
  To add a column: add another { heading, links: [...] } object.
  To add a link inside a column: add { label, href } to its links array.
  Links are filtered to routes that actually exist in this locale; a
  column with zero surviving links is dropped entirely (see Guides).
*/
const columns = [
  {
    heading: t.servicesHeading,
    links: [
      { label: t.systems, href: withLocale("/systems", locale) },
      { label: t.automations, href: withLocale("/automations", locale) },
      { label: t.websites, href: withLocale("/websites", locale) },
      { label: t.aiAgents, href: withLocale("/ai-agents", locale) },
    ].filter((link) => routeExists(link.href)),
  },
  {
    heading: t.companyHeading,
    links: [
      { label: t.contact, href: withLocale("/#contact", locale) },
    ],
  },
  ...(lpLinks.length > 0 ? [{ heading: t.guidesHeading, links: lpLinks }] : []),
].filter((col) => col.links.length > 0);

/*
  SOCIAL LINKS — add/remove social platforms here.
  Icons are simple SVG paths; swap them out if you change a platform.
*/
const socials = [
  { label: "LinkedIn", href: "https://linkedin.com/company/argo-navis", icon: "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" },
];

/* LEGAL TEXT — change the year or company name */
const year = new Date().getFullYear();
const companyName = "Argo Navis";
---

<footer class="border-t border-border-subtle bg-surface-900">
  <div class="mx-auto max-w-6xl px-6 py-12">

    <!-- Top row: logo + columns -->
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">

      <!-- Brand column -->
      <div class="lg:col-span-2">
        <a href={withLocale("/", locale)} class="text-xl font-bold text-text-primary">
          Argo <span class="text-brand-400">Navis</span>
        </a>
        <!--
          TAGLINE — one sentence that captures what you do.
          Keep it under ~12 words for best readability.
        -->
        <p class="mt-3 max-w-xs text-sm text-text-muted">
          {t.tagline}
        </p>

        <!-- Social icons -->
        <div class="mt-4 flex gap-3">
          {socials.map(s => (
            <a
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-icon"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                <path d={s.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Link columns -->
      {columns.map(col => (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-text-muted/80">
            {col.heading}
          </h3>
          <ul class="mt-3 space-y-2">
            {col.links.map(link => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-muted transition-colors hover:text-text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom row: copyright -->
    <div class="mt-10 border-t border-border-subtle pt-6 text-center text-xs text-text-muted/80">
      © {year} {companyName}. {t.rights}
    </div>

  </div>
</footer>
