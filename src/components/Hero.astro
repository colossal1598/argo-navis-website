---
/*
  PROPS — every string is override-able so this component works for both
  locales (and any future landing page): the HE homepage passes Hebrew
  copy here instead of hand-copying this section's markup.
    headline — biggest text on the page, ~8-12 words
    subline  — smaller, slightly muted, one punchy sentence
    cta      — single button: { label, href }. href points at a contact
               form section by default, but can be any URL (e.g. Calendly).
*/
interface HeroCta {
  label: string;
  href:  string;
}

interface Props {
  headline?: string;
  subline?:  string;
  cta?:      HeroCta;
}

const {
  headline = "Your website and workflows — sharp, professional, and actually working.",
  subline  = "Most businesses leak money through the cracks. We close them.",
  cta      = { label: "Book a Call", href: "/#contact" },
} = Astro.props;
---

<section class="relative overflow-hidden bg-surface-950 px-6 py-section-lg text-start md:py-section-xl">

  <div class="relative z-10 mx-auto max-w-3xl">

    <!--
      HEADLINE — h1 for SEO. Only one h1 per page.
      The copy is intentionally long and confident — let it wrap.
    -->
    <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
      {headline}
    </h1>

    <!-- SUBLINE — muted color, not competing with the headline -->
    <p class="mt-6 max-w-xl text-lg text-text-muted">
      {subline}
    </p>

    <!-- CTA BUTTON — token button classes (sharp corners, baked-in focus ring). -->
    <div class="mt-10">
      <a href={cta.href} class="btn btn-primary btn-lg">
        {cta.label}
      </a>
    </div>

  </div>
</section>
