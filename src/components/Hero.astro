---
/*
  PROPS — every string is override-able so this component works for both
  locales (and any future landing page): the HE homepage passes Hebrew
  copy here instead of hand-copying this section's markup.
    headline     — biggest text on the page, ~8-12 words
    subline      — smaller, slightly muted, one punchy sentence
    cta          — primary button: { label, href }. href points at a
                   contact form section by default, but can be any URL.
    ctaSecondary — optional second, lower-emphasis button (e.g. "see the
                   proof" linking to a case study or an in-page anchor).
                   Omit it on pages that only need one CTA.
*/
interface HeroCta {
  label: string;
  href:  string;
}

interface Props {
  headline?:     string;
  subline?:      string;
  cta?:          HeroCta;
  ctaSecondary?: HeroCta;
}

const {
  headline     = "Your website and workflows — sharp, professional, and actually working.",
  subline      = "Most businesses leak money through the cracks. We close them.",
  cta          = { label: "Book a Call", href: "/#contact" },
  ctaSecondary,
} = Astro.props;
---

<!-- section-sheen (round 7): faint top-light wash so the opening viewport doesn't read as one flat sheet — fades out inside the section, near-invisible on light theme by design. -->
<section class="section-sheen bg-surface-950 px-6 py-section-md text-start md:py-section-lg">

  <div class="mx-auto max-w-2xl">

    <!--
      HEADLINE — h1 for SEO. Only one h1 per page. Tightened container
      (max-w-2xl, was max-w-3xl) and rhythm below so a short, punchy
      headline reads as a deliberately tight composition rather than a
      long line of text stretched across a wide, sparse column — let it
      wrap onto two lines if it's short.
    -->
    <h1 class="reveal text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
      {headline}
    </h1>

    <!-- SUBLINE — muted color, not competing with the headline -->
    <p class="reveal mt-5 max-w-xl text-lg text-text-muted" style="--reveal-delay: 80">
      {subline}
    </p>

    <!-- CTAS — token button classes (sharp corners, baked-in focus ring). Secondary is optional. -->
    <div class="reveal mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center" style="--reveal-delay: 160">
      <a href={cta.href} class="btn btn-primary btn-lg">
        {cta.label}
      </a>
      {ctaSecondary && (
        <a href={ctaSecondary.href} class="btn btn-secondary btn-lg">
          {ctaSecondary.label}
        </a>
      )}
    </div>

  </div>
</section>
