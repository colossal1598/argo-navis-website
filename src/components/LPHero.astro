---
/*
  LP HERO — headline + subline only, no CTA button. Landing pages have
  exactly one conversion goal (the form further down the page); a hero
  button here would be a second competing action. Distinct from
  Hero.astro, which always renders at least one CTA button.

  PROPS:
    headline — the LP's core promise/angle, ~8-14 words
    subline  — one sentence of supporting context
*/
interface Props {
  headline: string;
  subline:  string;
}

const { headline, subline } = Astro.props;
---

<section class="bg-surface-950 px-6 py-section-lg text-start md:py-section-xl">
  <div class="mx-auto max-w-3xl">
    <h1 class="reveal text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
      {headline}
    </h1>
    <p class="reveal mt-6 max-w-xl text-lg text-text-muted" style="--reveal-delay: 80">
      {subline}
    </p>
  </div>
</section>
