---
import { switchLocalePath, type SiteLocale, withLocale } from "../lib/locale";

/*
  NAV LINKS — the array below controls every item in the navbar.
  Each link carries its own EN/HE label directly (a locale object) instead
  of a separate ternary chain matched by href — add a language, add a
  field; add a page, add an object.
  To remove a page: delete the object.
  The "active" highlight is automatic based on the current URL.
*/
const navLinks: { href: string; label: Record<SiteLocale, string> }[] = [
  { href: "/#services",  label: { en: "Services",    he: "שירותים" } },
  { href: "/automations", label: { en: "Automations", he: "אוטומציות" } },
  { href: "/websites",    label: { en: "Websites",    he: "אתרים" } },
];

interface Props {
  locale?: SiteLocale;
}

const { locale = "en" } = Astro.props;

/*
  LOCALE BEHAVIOR:
    - `locale` controls translated labels and localized href generation.
    - EN pages link to EN paths; HE pages link to /he paths.
*/
const isHebrew = locale === "he";
const logoHref = withLocale("/", locale);

/*
  CHROME COPY — every other user-facing string in this component (CTA
  label, toggle aria-labels) lives here, keyed by the current locale, so
  nothing is hard-coded inline in the markup below.
  Note on switchLocaleLabel: it names the SWITCH TARGET language, written
  in that target language — e.g. on an English page the label reads
  "החלף לעברית" (in Hebrew) because that's what a screen reader user is
  switching to. This preserves the original behavior, just centralized.
*/
const copy: Record<SiteLocale, {
  cta:              string;
  switchLocaleLabel: string;
  toggleTheme:      string;
  openMenu:         string;
  closeMenu:        string;
}> = {
  en: {
    cta:               "Book a Call",
    switchLocaleLabel: "החלף לעברית",
    toggleTheme:       "Toggle dark mode",
    openMenu:          "Open menu",
    closeMenu:         "Close menu",
  },
  he: {
    cta:               "קבעו שיחה",
    switchLocaleLabel: "Switch to English",
    toggleTheme:       "החלפת מצב תאורה",
    openMenu:          "פתח תפריט",
    closeMenu:         "סגור תפריט",
  },
};
const t = copy[locale];
const ctaHref = withLocale("/#contact", locale);

/* Localized navigation labels keep structure identical across both languages. */
const localizedLinks = navLinks.map((link) => ({
  label: link.label[locale],
  href: withLocale(link.href, locale),
}));

const currentPath = Astro.url.pathname;

/*
  LANGUAGE TOGGLE TARGET:
  Some pages exist in only one language (e.g. showcase sub-pages that were
  never translated). Naively switching the prefix would produce a 404, so we
  check the switched path against the real route list (from src/pages) and
  fall back to the closest existing parent page instead.
*/
const pageFiles = import.meta.glob("../pages/**/*.astro");
const existingRoutes = new Set(
  Object.keys(pageFiles).map((file) => {
    const route = file
      .replace("../pages", "")
      .replace(/\/index\.astro$/, "")
      .replace(/\.astro$/, "");
    return route === "" ? "/" : route;
  })
);

function nearestExistingPath(path: string): string {
  let candidate = path.replace(/\/+$/, "") || "/";
  while (candidate !== "/") {
    if (existingRoutes.has(candidate)) return candidate;
    candidate = candidate.slice(0, candidate.lastIndexOf("/")) || "/";
  }
  return "/";
}

/* Language toggle targets the equivalent route in the other locale. */
const localeSwitchHref = `${nearestExistingPath(switchLocalePath(Astro.url.pathname))}${Astro.url.search}`;
const currentLocaleFlag = isHebrew ? "he" : "en";
---

<!--
  sticky + backdrop-blur = the nav sticks to the top and gets a
  frosted-glass effect when you scroll past content.
  z-50 makes sure it sits above everything else on the page.
-->
<header class="sticky top-0 z-50 border-b border-border-subtle bg-surface-950/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">

    <!--
      LOGO — change the text or swap in an <img> tag.
      The href="/" always takes the user back to the homepage.
    -->
    <a
      href={logoHref}
      class="flex items-center gap-2 text-xl font-bold tracking-tight text-text-primary"
    >

      <span>
        Argo <span class="text-brand-400">Navis</span>
      </span>
         </a>

    <!-- Desktop nav: links + theme toggle + CTA -->
    <div class="hidden items-center gap-6 md:flex">
      <ul class="flex items-center gap-8">
        {localizedLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={[
                "focus-ring rounded-sm text-sm font-medium transition-colors hover:text-brand-400",
                currentPath === link.href || (link.href !== withLocale("/#services", locale) && currentPath.startsWith(`${link.href}/`))
                  ? "text-text-primary"
                  : "text-text-muted",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Language switch button — sits next to the theme toggle -->
      <a
        data-language-toggle
        href={localeSwitchHref}
        class="btn-icon gap-1.5"
        aria-label={t.switchLocaleLabel}
      >
        {currentLocaleFlag === "en" ? (
          <>
            <svg class="h-3.5 w-5 rounded-[2px]" viewBox="0 0 60 40" aria-hidden="true">
              <rect width="60" height="40" fill="#012169"></rect>
              <path d="M0 0l60 40M60 0L0 40" stroke="#fff" stroke-width="8"></path>
              <path d="M0 0l60 40M60 0L0 40" stroke="#C8102E" stroke-width="4"></path>
              <path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="14"></path>
              <path d="M30 0v40M0 20h60" stroke="#C8102E" stroke-width="8"></path>
            </svg>
            <span aria-hidden="true">EN</span>
          </>
        ) : (
          <>
            <svg class="h-3.5 w-5 rounded-[2px]" viewBox="0 0 60 40" aria-hidden="true">
              <rect width="60" height="40" fill="#fff"></rect>
              <rect y="3" width="60" height="6" fill="#0038B8"></rect>
              <rect y="31" width="60" height="6" fill="#0038B8"></rect>
              <path d="M30 12l6.2 10.8H23.8z" fill="none" stroke="#0038B8" stroke-width="2"></path>
              <path d="M30 28l-6.2-10.8h12.4z" fill="none" stroke="#0038B8" stroke-width="2"></path>
            </svg>
            <span aria-hidden="true">עב</span>
          </>
        )}
      </a>

      <!-- Theme toggle button -->
      <button
        id="theme-toggle"
        class="btn-icon"
        type="button"
        aria-label={t.toggleTheme}
      >
        <!-- Sun icon (light mode indicator) -->
        <svg
          id="icon-sun"
          class="h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="M4.93 4.93l1.41 1.41" />
          <path d="M17.66 17.66l1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="M4.93 19.07l1.41-1.41" />
          <path d="M17.66 6.34l1.41-1.41" />
        </svg>

        <!-- Moon icon (dark mode indicator) -->
        <svg
          id="icon-moon"
          class="hidden h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <!-- CTA button — stands out from the nav links -->
      <a href={ctaHref} class="btn btn-primary btn-md">
        {t.cta}
      </a>
    </div>

    <!--
      Mobile hamburger — only visible below md breakpoint.
      The actual toggle logic is handled by the <script> below.
    -->
    <div class="flex items-center gap-0 md:hidden">
      <!-- Mobile theme + locale controls -->
      <button
        id="theme-toggle-mobile"
        class="btn-icon"
        type="button"
        aria-label={t.toggleTheme}
      >
        <svg
          id="icon-sun-mobile"
          class="h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="M4.93 4.93l1.41 1.41" />
          <path d="M17.66 17.66l1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="M4.93 19.07l1.41-1.41" />
          <path d="M17.66 6.34l1.41-1.41" />
        </svg>
        <svg
          id="icon-moon-mobile"
          class="hidden h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <a
        data-language-toggle
        href={localeSwitchHref}
        class="btn-icon gap-1.5"
        aria-label={t.switchLocaleLabel}
      >
        {currentLocaleFlag === "en" ? (
          <>
            <svg class="h-3.5 w-5 rounded-[2px]" viewBox="0 0 60 40" aria-hidden="true">
              <rect width="60" height="40" fill="#012169"></rect>
              <path d="M0 0l60 40M60 0L0 40" stroke="#fff" stroke-width="8"></path>
              <path d="M0 0l60 40M60 0L0 40" stroke="#C8102E" stroke-width="4"></path>
              <path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="14"></path>
              <path d="M30 0v40M0 20h60" stroke="#C8102E" stroke-width="8"></path>
            </svg>
            <span aria-hidden="true">EN</span>
          </>
        ) : (
          <>
            <svg class="h-3.5 w-5 rounded-[2px]" viewBox="0 0 60 40" aria-hidden="true">
              <rect width="60" height="40" fill="#fff"></rect>
              <rect y="3" width="60" height="6" fill="#0038B8"></rect>
              <rect y="31" width="60" height="6" fill="#0038B8"></rect>
              <path d="M30 12l6.2 10.8H23.8z" fill="none" stroke="#0038B8" stroke-width="2"></path>
              <path d="M30 28l-6.2-10.8h12.4z" fill="none" stroke="#0038B8" stroke-width="2"></path>
            </svg>
            <span aria-hidden="true">עב</span>
          </>
        )}
      </a>

      <!-- Mobile hamburger — stacked bars, so it keeps its own layout classes
           rather than .btn-icon (which centers a single icon). -->
      <button
        id="menu-toggle"
        class="focus-ring flex flex-col gap-1.5 rounded-md p-2 text-text-muted transition-colors hover:bg-surface-800"
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
      >
        <span class="h-0.5 w-6 bg-text-primary transition-all"></span>
        <span class="h-0.5 w-6 bg-text-primary transition-all"></span>
        <span class="h-0.5 w-6 bg-text-primary transition-all"></span>
      </button>
    </div>
  </nav>

  <!--
    MOBILE MENU — starts hidden (max-h-0 overflow-hidden).
    When the button is clicked, the script below adds the "open" class
    which expands it smoothly via CSS transition.
  -->
  <div
    id="mobile-menu"
    class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out md:hidden"
  >
    <ul class="flex flex-col gap-1 px-6 pb-4">
      {localizedLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="focus-ring block rounded-md px-3 py-2 text-sm font-medium text-text-muted transition-colors hover:bg-surface-800 hover:text-text-primary"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2">
        <a href={ctaHref} class="btn btn-primary btn-md w-full">
          {t.cta}
        </a>
      </li>
    </ul>
  </div>
</header>

<!--
  CSS-driven icon init: correct sun/moon visibility is set by data-theme
  before the deferred JS runs, preventing a flash of the wrong icon.
-->
<style>
  html[data-theme="light"] #icon-sun,
  html[data-theme="light"] #icon-sun-mobile { display: block; }
  html[data-theme="light"] #icon-moon,
  html[data-theme="light"] #icon-moon-mobile { display: none; }
  html[data-theme="dark"] #icon-sun,
  html[data-theme="dark"] #icon-sun-mobile { display: none; }
  html[data-theme="dark"] #icon-moon,
  html[data-theme="dark"] #icon-moon-mobile { display: block; }
</style>

<!--
  Vanilla JS island — no framework needed for a simple toggle.
  This script runs in the browser after the page loads.
-->
<script>
  const toggle = document.getElementById("menu-toggle");
  const menu   = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("max-h-96");
    menu?.classList.toggle("max-h-0",  isOpen);
    menu?.classList.toggle("max-h-96", !isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", !isOpen
      ? (toggle.dataset.labelClose ?? "Close menu")
      : (toggle.dataset.labelOpen  ?? "Open menu")
    );
  });

  // Theme toggle logic – syncs desktop & mobile buttons and persists preference.
  const htmlEl = document.documentElement;

  const desktopToggle = document.getElementById("theme-toggle");
  const mobileToggle  = document.getElementById("theme-toggle-mobile");

  const iconSun        = document.getElementById("icon-sun");
  const iconMoon       = document.getElementById("icon-moon");
  const iconSunMobile  = document.getElementById("icon-sun-mobile");
  const iconMoonMobile = document.getElementById("icon-moon-mobile");

  const THEME_KEY = "argo-theme";

  function applyTheme(theme: "light" | "dark") {
    htmlEl.setAttribute("data-theme", theme);

    const isLight = theme === "light";

    if (iconSun && iconMoon) {
      iconSun.classList.toggle("hidden", !isLight);
      iconMoon.classList.toggle("hidden", isLight);
    }

    if (iconSunMobile && iconMoonMobile) {
      iconSunMobile.classList.toggle("hidden", !isLight);
      iconMoonMobile.classList.toggle("hidden", isLight);
    }
  }

  // Initialize theme from localStorage or system preference.
  (function initTheme() {
    const stored = window.localStorage.getItem(THEME_KEY);
    if (stored === "light" || stored === "dark") {
      applyTheme(stored);
      return;
    }
    const prefersLight = window.matchMedia &&
      window.matchMedia("(prefers-color-scheme: light)").matches;
    applyTheme(prefersLight ? "light" : "dark");
  })();

  function toggleTheme() {
    const current = htmlEl.getAttribute("data-theme") || "dark";
    const next = current === "dark" ? "light" : "dark";
    window.localStorage.setItem(THEME_KEY, next);
    applyTheme(next);
  }

  desktopToggle?.addEventListener("click", toggleTheme);
  mobileToggle?.addEventListener("click", toggleTheme);

  // Keep query/hash during language switching for deep links and sections.
  const languageToggles = document.querySelectorAll("[data-language-toggle]");
  languageToggles.forEach((toggleEl) => {
    toggleEl.addEventListener("click", (event) => {
      const anchor = event.currentTarget as HTMLAnchorElement;
      if (!anchor?.href) return;
      const url = new URL(anchor.href);
      const hash = window.location.hash;
      if (hash) {
        url.hash = hash;
      }
      anchor.href = `${url.pathname}${url.search}${url.hash}`;
    });
  });
</script>
