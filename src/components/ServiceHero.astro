---
/*
  PROPS — passed in by each service page.
  Every service page has its own headline, sub-copy, and accent color.

    eyebrow      — small label above the headline (e.g. "Service")
    headline     — main h1 for the service
    body         — 1-2 sentences describing the service
    accent       — "brand" | "gold" | "slate" — controls the badge colour
    ctaPrimary   — { label, href } for the main CTA (default: contact form)
    ctaSecondary — { label, href } for the secondary CTA (default: examples)

  Every string is a prop so this component works for either locale —
  previously the two CTA labels below were hardcoded English with no way
  to override them at all.
*/
interface CtaConfig {
  label: string;
  href:  string;
}

interface Props {
  eyebrow:       string;
  headline:      string;
  body:          string;
  accent?:       "brand" | "gold" | "slate";
  ctaPrimary?:   CtaConfig;
  ctaSecondary?: CtaConfig;
}

const {
  eyebrow, headline, body,
  accent = "brand",
  ctaPrimary   = { label: "Get Started",  href: "#contact" },
  ctaSecondary = { label: "See Examples", href: "#showcases" },
} = Astro.props;

/* Accent -> badge token class. Add a new accent here if a 4th is ever needed. */
const accentBadgeClass = {
  brand: "badge-brand",
  gold:  "badge-gold",
  slate: "badge-slate",
} as const;
---

<section class="relative overflow-hidden bg-surface-950 px-6 py-section-lg text-center md:py-section-xl">

  <div class="relative z-10 mx-auto max-w-3xl">

    <!-- Eyebrow badge — small-radius token badge, never a pill -->
    <div class={`badge ${accentBadgeClass[accent]} mb-5`}>
      {eyebrow}
    </div>

    <!-- Headline — rendered as h1 for SEO -->
    <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
      {headline}
    </h1>

    <!-- Body copy -->
    <p class="mx-auto mt-6 max-w-2xl text-lg text-text-muted">
      {body}
    </p>

    <!-- CTAs anchor to the contact form / examples lower on the page -->
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href={ctaPrimary.href} class="btn btn-primary btn-lg">
        {ctaPrimary.label}
      </a>
      <a href={ctaSecondary.href} class="btn btn-secondary btn-lg">
        {ctaSecondary.label}
      </a>
    </div>

  </div>
</section>
