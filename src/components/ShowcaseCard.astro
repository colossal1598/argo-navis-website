---
/*
  PROPS — one card = one showcase / case study.

    title       — project name
    description — one-line summary of the result
    tags        — array of small labels (e.g. ["Make", "Notion", "CRM"])
    href        — link to the full showcase sub-page (e.g. "/automations/crm-sync")
                  omit it until the case-study page exists — the card then
                  renders without the "View case study" link (no dead links)
    metric      — an eye-catching number / stat (optional)
                  e.g. "3× faster onboarding"
*/
interface Props {
  title:       string;
  description: string;
  tags:        string[];
  href?:       string;
  metric?:     string;
}

const { title, description, tags, href, metric } = Astro.props;
---

<article class="group card">

  <!-- Optional metric badge — shown in the top-right corner if provided. Token badge, never a pill. -->
  {metric && (
    <span class="badge badge-brand absolute end-5 top-5">
      {metric}
    </span>
  )}

  <!-- Title -->
  <h3 class="pe-20 text-lg font-semibold text-text-primary">{title}</h3>

  <!-- Description -->
  <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{description}</p>

  <!-- Tags -->
  <div class="mt-4 flex flex-wrap gap-2">
    {tags.map(tag => (
      <span class="badge badge-muted">
        {tag}
      </span>
    ))}
  </div>

  <!--
    "View case study" link — .card-link-overlay makes the entire card
    clickable without wrapping everything in an <a>.
    Only rendered when href is set, so cards never point at 404s.
  -->
  {href && (
    <a
      href={href}
      class="card-link-overlay mt-5 inline-flex items-center gap-1 text-sm font-medium text-brand-400 transition-all"
    >
      View case study
      <svg class="icon-chevron h-4 w-4 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  )}

</article>
