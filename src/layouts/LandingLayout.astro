---
/*
  LANDING LAYOUT — chrome-free shell for standalone landing pages (ad
  campaigns, cold-outreach links, etc). No site navigation and only a
  minimal "back to the main site" footer link, so a visitor stays focused
  on the LP's own CTA instead of wandering into the rest of the site.
  Shares the same design tokens / theme system as the main Layout.

  PROPS:
    title       (required) — shown in the browser tab and used by SEO
    description (optional) — shown in Google search snippets
    locale      (optional) — "en" | "he", defaults to "en"
    dir         (optional) — defaults from locale
    noindex     (optional) — defaults to FALSE: unlike internal pages
                             (e.g. the style guide), landing pages ARE
                             meant to be indexed.
*/
import { type SiteLocale, stripLocalePrefix, withLocale } from "../lib/locale";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  locale?: SiteLocale;
  dir?: "ltr" | "rtl";
  noindex?: boolean;
}

const {
  title,
  description = "Argo Navis – automations and websites that grow your business.",
  locale = "en",
  dir = locale === "he" ? "rtl" : "ltr",
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.SITE ?? "https://argo-navis.net";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
/*
  HREFLANG ALTERNATES — ported from Layout.astro (launch verification
  finding, Task 4.1): this layout was emitting no hreflang alternates
  at all, so every LP (4 pages × 2 locales = 8 indexed pages) was
  missing them. Same `stripLocalePrefix`/`withLocale` pairing Layout.astro
  uses, so EN/HE LPs correctly point at each other in both directions.

  ROUTE-EXISTENCE CHECK (Task 4.3 fix): unlike the main Layout, LPs are
  sometimes locale-exclusive by design — e.g. /he/lp/order is a Meta-ads
  page with no EN counterpart. Emitting an "en" (and therefore
  "x-default", which points at the EN URL) alternate to a route that
  doesn't exist would hand search engines a broken link. Same
  `import.meta.glob`/`routeExists` pattern Navigation.astro already uses
  for nav-link filtering, applied here to alternate-link filtering.
*/
const pageFiles = import.meta.glob("../pages/**/*.astro");
const existingRoutes = new Set(
  Object.keys(pageFiles).map((file) => {
    const route = file
      .replace("../pages", "")
      .replace(/\/index\.astro$/, "")
      .replace(/\.astro$/, "");
    return route === "" ? "/" : route;
  })
);
function routeExists(path: string): boolean {
  // Astro.url.pathname carries a trailing slash during static prerender
  // (directory-style output routes) but existingRoutes keys don't —
  // normalize before checking, same trim Navigation.astro's
  // nearestExistingPath uses.
  const normalized = path.replace(/\/+$/, "") || "/";
  return existingRoutes.has(normalized);
}

const canonicalPath = stripLocalePrefix(Astro.url.pathname);
const englishPath = withLocale(canonicalPath, "en");
const hebrewPath = withLocale(canonicalPath, "he");
const englishRouteExists = routeExists(englishPath);
const hebrewRouteExists = routeExists(hebrewPath);
const englishURL = new URL(englishPath, siteUrl);
const hebrewURL = new URL(hebrewPath, siteUrl);

/* Minimal footer copy — just a way back to the main site, no nav/service links. */
const copy: Record<SiteLocale, { backToSite: string; rights: string }> = {
  en: { backToSite: "Argo Navis — back to the main site", rights: "All rights reserved." },
  he: { backToSite: "Argo Navis — חזרה לאתר הראשי", rights: "כל הזכויות שמורות." },
};
const t = copy[locale];
const year = new Date().getFullYear();

/*
  FONT — unlike the main Layout (which always needs both scripts loaded,
  since a single visitor can switch locale via the nav), a landing page
  is locked to one locale for its whole life — there's no in-page locale
  switcher. Loading the unused script's weights was pure dead weight on
  every LP request (audit finding, Task 2.4) — request only what this
  page will actually render.
*/
const fontFamily = locale === "he"
  ? "family=Heebo:wght@400;500;600;700;800"
  : "family=Inter:wght@400;500;600;700;800";
---

<!doctype html>
<html lang={locale} dir={dir} class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Primary meta -->
    <title>{title} | Argo Navis</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    {englishRouteExists && <link rel="alternate" hreflang="en" href={englishURL} />}
    {hebrewRouteExists && <link rel="alternate" hreflang="he" href={hebrewURL} />}
    {englishRouteExists && <link rel="alternate" hreflang="x-default" href={englishURL} />}

    <!-- NOINDEX — opt-in only; landing pages are indexed by default -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!--
      OPEN GRAPH — controls how the page looks when shared on
      LinkedIn, Slack, WhatsApp, etc.
    -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={`${title} | Argo Navis`} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={`${siteUrl}/og-image.png`} />

    <!-- FONT — same family/weights as the main Layout, just scoped to the one script this locale actually renders (see fontFamily above). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={`https://fonts.googleapis.com/css2?${fontFamily}&display=swap`}
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (() => {
        const key = "argo-theme";
        const html = document.documentElement;

        // Marks JS as available BEFORE first paint. `.reveal` (global.css)
        // only hides content when `.js` is present on <html> — so a
        // visitor with JS disabled/blocked never sees hidden content
        // waiting on a script that will never run. Same fix as the main
        // Layout.astro (Task 2.3) — LandingLayout didn't have it yet.
        html.classList.add("js");

        const stored = localStorage.getItem(key);
        if (stored === "light" || stored === "dark") {
          html.setAttribute("data-theme", stored);
          return;
        }
        const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        html.setAttribute("data-theme", prefersLight ? "light" : "dark");
      })();
    </script>
  </head>

  <body class="min-h-screen bg-surface-950 text-text-primary antialiased">

    <!--
      No <Navigation /> here on purpose — landing pages have one job
      (convert on their own CTA), so there's nothing pulling visitors
      away to browse the rest of the site.
    -->
    <main>
      <slot />
    </main>

    <!-- Minimal footer — just a quiet way back to the main site. -->
    <footer class="border-t border-border-subtle bg-surface-900 px-6 py-8 text-center text-xs text-text-muted">
      <!--
        .focus-ring-on-900 corrects the ring-offset color for this
        footer's real background (surface-900, not .focus-ring's
        hardcoded surface-950 default) — see global.css for why a plain
        utility can't do this (audit finding, Task 2.4).
      -->
      <a href={withLocale("/", locale)} class="focus-ring focus-ring-on-900 rounded-sm hover:text-text-primary">
        {t.backToSite}
      </a>
      <p class="mt-2">© {year} Argo Navis. {t.rights}</p>
    </footer>

  </body>
</html>

<!--
  SCROLL-REVEAL OBSERVER — same shared mechanism as the main Layout.astro
  (Task 2.3). `.reveal` starts hidden/offset only under `.js` (see the
  inline script above); this observer adds `.is-visible` once an element
  scrolls into view. Lives here so any LP using `.reveal` gets it without
  re-wiring per page.
-->
<script>
  const revealItems = Array.from(document.querySelectorAll(".reveal"));

  if (revealItems.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    revealItems.forEach((item) => observer.observe(item));
  }
</script>
