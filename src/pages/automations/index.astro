---
/*
  PAGE GOAL: /automations service page. Convert visitors doing manual,
  repetitive data-shuffling (WhatsApp orders retyped, invoices matched by
  hand) into diagnostic leads. Same lead source tag ("automations") as the
  page this replaces — only the wording changed, not the funnel.

  Copy source: .apm/memory/copy/service-automations-en.md — re-read that
  file before editing any string below; it is the approved source of
  truth, not this file. Rebuilt on the Task 2.3 homepage exemplar's token
  set and motion language (py-section-*, .reveal + --reveal-delay).
*/
import Layout from "../../layouts/Layout.astro";
import ProcessBlock from "../../components/ProcessBlock.astro";
import FAQBlock from "../../components/FAQBlock.astro";
import ContactForm from "../../components/ContactForm.astro";

/* WHAT WE AUTOMATE — four tiles. "System integrations" replaces the old
   "Social scheduling" tile per the copy file — closer to what this ICP
   actually asks for, and it's where the one real proof point lives. */
const automateTiles = [
  {
    title: "Reporting",
    body:  "Automated reports delivered to your inbox, no spreadsheet wrangling.",
  },
  {
    title: "Invoicing and admin",
    body:  "Deliveries and orders matched to invoices automatically, not by memory at month-end.",
  },
  {
    title: "Messaging",
    body:  "Automatic WhatsApp follow-ups, so no lead or client falls through the cracks.",
  },
  {
    title: "System integrations",
    body:  "Morning, WhatsApp, and your spreadsheets, made to talk to each other instead of you being the bridge.",
  },
];

/* PROCESS — same four steps as before, step 3's description sharpened
   per the copy file (replaces the vaguer "Systems connected, tested, and
   running"). */
const processSteps = [
  {
    label:       "You show us your workflow",
    description: "Walk us through what you're doing every day.",
  },
  {
    label:       "We identify what can run itself",
    description: "Map out every step that doesn't need a human.",
  },
  {
    label:       "We build it",
    description: "Connected to what you already use, tested before handover.",
  },
  {
    label:       "You get time back",
    description: "We hand it over and make sure it sticks.",
  },
];

const faq = [
  {
    q: "I don't even know what could be automated in my business.",
    a: "We do. That's the first step — you walk us through your day and we spot what shouldn't need a human.",
  },
  {
    q: "What happens if something breaks?",
    a: "We build with reliability in mind and test before handover. If something breaks after, we fix it.",
  },
  {
    q: "Do I need to be technical to work with you?",
    a: "Not at all. You explain what you do, we handle the rest.",
  },
];

/* FORM FIELDS — message placeholder sharpened per the copy file
   (from the generic "Tell us what you're doing manually"). */
const automationFormFields = [
  {
    id:          "name",
    label:       "Your name",
    type:        "text" as const,
    placeholder: "Your name",
    required:    true,
  },
  {
    id:          "email",
    label:       "Email",
    type:        "email" as const,
    placeholder: "you@company.com",
    required:    true,
  },
  {
    id:          "website",
    label:       "Website",
    type:        "url" as const,
    placeholder: "yoursite.com (if you have one)",
    required:    false,
  },
  {
    id:          "message",
    label:       "What do you want to automate?",
    type:        "textarea" as const,
    placeholder: "Tell us what you're copying by hand right now",
    required:    true,
  },
];
---

<Layout
  title="Automations"
  description="We connect what you already use — Morning, WhatsApp, your spreadsheets — so nothing gets typed in twice."
>

  <!-- HERO — headline kept verbatim (already passes the voice bar); subhead sharpened to name the actual systems. No CTA — let them scroll into the problem first. -->
  <section class="relative overflow-hidden bg-surface-950 px-6 py-section-lg text-start md:py-section-xl">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="reveal text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
        Why spend 10 hours on work a computer can do in 10 minutes?
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg text-text-muted" style="--reveal-delay: 80">
        We connect what you already use — Morning, WhatsApp, your spreadsheets — so nothing gets typed in twice.
      </p>
    </div>
  </section>

  <!-- PROBLEM BLOCK — three concrete pain lines, no adjectives doing the work. -->
  <section class="bg-surface-900 px-6 py-section-md">
    <div class="mx-auto max-w-3xl space-y-6">
      {[
        "Orders come in on WhatsApp. Someone still retypes them into a spreadsheet.",
        "Invoices sit in Morning, deliveries get tracked somewhere else — matched by hand, every month.",
        "A follow-up that slips costs a client. A forgotten check costs money.",
      ].map((line, i) => (
        <p class="reveal text-2xl font-semibold text-text-primary md:text-3xl" style={`--reveal-delay: ${i * 80}`}>{line}</p>
      ))}
    </div>
  </section>

  <!-- WHAT WE DO — includes the one real proof point (~940 synced documents, from the flagship system). -->
  <section class="bg-surface-950 px-6 py-section-md">
    <div class="mx-auto max-w-3xl">
      <p class="reveal text-lg text-text-soft md:text-xl">
        We map out everything you're doing manually — copying orders, matching invoices, chasing follow-ups — and connect the systems you already have so it happens on its own. On one project, that meant syncing about 940 accounting documents automatically, with zero manual matching.
        <br />
        <span class="mt-3 inline-block font-semibold text-text-primary">Without you babysitting it.</span>
      </p>
    </div>
  </section>

  <!-- WHAT WE AUTOMATE — four static info tiles, not clickable, so no hover/link affordance. -->
  <section class="bg-surface-950 px-6 py-section-md">
    <div class="mx-auto max-w-5xl border-t border-border-subtle pt-16">
      <h2 class="reveal text-3xl font-bold text-text-primary md:text-4xl">What we automate</h2>
      <p class="reveal mt-3 max-w-2xl text-text-muted" style="--reveal-delay: 60">
        Four of the most common places we start. The specifics change, the outcome doesn't — less manual work, more time back.
      </p>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {automateTiles.map((tile, i) => (
          <div class="reveal rounded-2xl border border-border-subtle bg-surface-900 p-6" style={`--reveal-delay: ${100 + i * 80}`}>
            <h3 class="text-lg font-semibold text-text-primary">{tile.title}</h3>
            <p class="mt-2 text-text-muted">{tile.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <ProcessBlock
    heading="What working with us looks like"
    steps={processSteps}
  />

  <!-- FAQ -->
  <FAQBlock items={faq} />

  <!-- CONTACT FORM -->
  <ContactForm
    heading="Not sure where to start? That's what the first conversation is for."
    source="automations"
    fields={automationFormFields}
    reassurance="We usually reply within 24 hours."
  />

</Layout>
