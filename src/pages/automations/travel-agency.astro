import ShowcaseLayout from "../../layouts/ShowcaseLayout.astro";
import ShowcaseSection from "../../components/ShowcaseSection.astro";
import ContactForm from "../../components/ContactForm.astro";

/* Build-window facts only — no counts of any kind for the automation
   suite, per the copy file's explicit instruction not to attach numbers
   to that half of the work. */
const metrics = [
  { value: "2", label: "custom systems built" },
  { value: "~1 week", label: "internal tools portal build time" },
  { value: "~2 months", label: "WhatsApp inbox build time" },
];

const decisions = [
  {
    decision: "Two separate systems instead of one monolith",
    why:      "The portal and the WhatsApp inbox serve different jobs — internal tool access vs. customer messaging — and can be built, deployed, and changed independently.",
  },
  {
    decision: "A real database as the source of truth for WhatsApp",
    why:      "The inbox's own database, not the chat window, holds the record of every conversation — so the interface can be rebuilt or changed without losing history.",
  },
  {
    decision: "Session-window and template-message handling built explicitly",
    why:      "WhatsApp's own rules (a 24-hour window to reply freely, template messages required after) are handled in code, not left to chance.",
  },
  {
    decision: "An automated activity log for automation workflows",
    why:      "Every automated action gets a record — what ran, whether it worked, and its estimated cost — visible in one place instead of buried in logs.",
  },
];

const takeaways = [
  "Not every project is one system. Sometimes the right shape is two smaller ones, each doing one job well.",
  "Building a WhatsApp inbox from scratch, instead of wrapping an existing tool, means the business's own data — not a vendor's — is the record of every conversation.",
  "WhatsApp has real rules (a 24-hour reply window, template messages after). Handling them explicitly beats hoping they don't come up.",
  "An automated activity log pays for itself the first time something needs debugging — \"what happened and why\" shouldn't require digging through raw logs.",
  "AI is genuinely useful for the boring, well-defined part of a workflow — rewriting a document's text — not for the whole workflow.",
];
