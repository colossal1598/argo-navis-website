---
/*
  PAGE GOAL (HE): mirrors the rebuilt /automations exactly, section for
  section, via the same shared components (Layout, ProcessBlock,
  FAQBlock, ContactForm) — no hand-copied markup. Rebuilt from the
  approved copy file (previous draft on this page predated the EN
  rebuild and had gone stale — old problem-block lines, no proof point,
  the pre-Task-3.4 "content scheduling" tile instead of "system
  integrations"). Draft-quality Hebrew copy is acceptable (the owner
  sharpens post-launch).

  Copy source: .apm/memory/copy/he/service-automations-he.md — re-read
  that file before editing any string below; it is the approved source
  of truth, not this file. Source tag: automations-he (existing leads.ts
  key).
*/
import Layout from "../../../layouts/Layout.astro";
import ProcessBlock from "../../../components/ProcessBlock.astro";
import FAQBlock from "../../../components/FAQBlock.astro";
import ContactForm from "../../../components/ContactForm.astro";

const automateTiles = [
  { title: "דוחות", body: "דוחות אוטומטיים שמגיעים לתיבת הדואר, בלי התעסקות עם גיליונות." },
  { title: "חשבוניות ואדמיניסטרציה", body: "משלוחים והזמנות מותאמים לחשבוניות אוטומטית, לא מהזיכרון בסוף החודש." },
  { title: "הודעות", body: "מעקב אוטומטי בוואטסאפ, כך שאף ליד או לקוח לא נופל בין הכיסאות." },
  { title: "חיבור מערכות", body: "מורנינג, וואטסאפ, והגיליונות שלכם, מדברים אחד עם השני במקום שאתם תהיו הגשר." },
];

const processSteps = [
  { label: "מראים לנו את תהליך העבודה", description: "עוברים איתנו על מה שאתם עושים כל יום." },
  { label: "מזהים מה יכול לרוץ לבד", description: "ממפים כל שלב שלא צריך בן אדם." },
  { label: "בונים את זה", description: "מחובר למה שכבר יש לכם, בדוק לפני המסירה." },
  { label: "מקבלים זמן בחזרה", description: "מוסרים לכם ומוודאים שזה נשאר." },
];

const faq = [
  {
    q: "אני אפילו לא יודע מה אפשר לאטמט אצלי בעסק.",
    a: "אנחנו יודעים. זה בדיוק השלב הראשון — אתם עוברים איתנו על היום שלכם ואנחנו מזהים מה לא צריך בן אדם.",
  },
  {
    q: "מה קורה אם משהו נשבר?",
    a: "אנחנו בונים עם אמינות בראש ובודקים לפני המסירה. אם משהו נשבר אחר כך, אנחנו מתקנים.",
  },
  {
    q: "אני צריך להיות טכני כדי לעבוד איתכם?",
    a: "בכלל לא. אתם מסבירים מה אתם עושים, אנחנו מטפלים בשאר.",
  },
];

const automationFormFields = [
  { id: "name", label: "שם מלא", type: "text" as const, placeholder: "איך קוראים לך?", required: true },
  { id: "email", label: "אימייל", type: "email" as const, placeholder: "you@company.com", required: true },
  { id: "website", label: "אתר", type: "url" as const, placeholder: "האתר שלכם (אם יש)", required: false },
  {
    id:          "message",
    label:       "מה תרצו לאטמט?",
    type:        "textarea" as const,
    placeholder: "ספרו לנו מה אתם מעתיקים ביד כרגע",
    required:    true,
  },
];
---

<Layout
  title="אוטומציות"
  description="אנחנו מחברים את מה שכבר יש לכם — מורנינג, וואטסאפ, הגיליונות שלכם — כך שכלום לא מוקלד פעמיים."
  locale="he"
  dir="rtl"
>

  <!-- HERO — כותרת נשארת ללא שינוי, תת-כותרת מחודדת, בלי כפתור CTA -->
  <section class="relative overflow-hidden bg-surface-950 px-6 py-section-lg text-start md:py-section-xl">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="reveal text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
        למה לבזבז 10 שעות על עבודה שמחשב עושה ב-10 דקות?
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg text-text-muted" style="--reveal-delay: 80">
        אנחנו מחברים את מה שכבר יש לכם — מורנינג, וואטסאפ, הגיליונות שלכם — כך שכלום לא מוקלד פעמיים.
      </p>
    </div>
  </section>

  <!-- PROBLEM BLOCK -->
  <section class="bg-surface-900 px-6 py-section-md">
    <div class="mx-auto max-w-3xl space-y-6">
      {[
        "ההזמנות נכנסות בוואטסאפ. מישהו עדיין מקליד אותן מחדש לתוך גיליון.",
        "החשבוניות יושבות במורנינג, המשלוחים נרשמים במקום אחר — ומתואמים ביד, כל חודש.",
        "מעקב שמתפספס עולה בלקוח. צ'ק שנשכח עולה בכסף.",
      ].map((line, i) => (
        <p class="reveal text-2xl font-semibold text-text-primary md:text-3xl" style={`--reveal-delay: ${i * 80}`}>{line}</p>
      ))}
    </div>
  </section>

  <!-- WHAT WE DO — כולל נקודת ההוכחה (כ-940 מסמכים מסונכרנים) -->
  <section class="bg-surface-950 px-6 py-section-md">
    <div class="mx-auto max-w-3xl">
      <p class="reveal text-lg text-text-soft md:text-xl">
        אנחנו ממפים כל מה שאתם עושים ידנית — העתקת הזמנות, התאמת חשבוניות, מעקב אחר לקוחות — ומחברים את המערכות שכבר יש לכם כך שזה קורה לבד. בפרויקט אחד זה אומר סנכרון של כ-940 מסמכי הנהלת חשבונות באופן אוטומטי, בלי שום התאמה ידנית.
        <br />
        <span class="mt-3 inline-block font-semibold text-text-primary">בלי שתצטרכו לשמור עליה.</span>
      </p>
    </div>
  </section>

  <!-- WHAT WE AUTOMATE -->
  <section class="bg-surface-950 px-6 py-section-md">
    <div class="mx-auto max-w-5xl border-t border-border-subtle pt-16">
      <h2 class="reveal text-3xl font-bold text-text-primary md:text-4xl">מה אנחנו מאטמטים</h2>
      <p class="reveal mt-3 max-w-2xl text-text-muted" style="--reveal-delay: 60">
        ארבעה מהמקומות הכי נפוצים שבהם אנחנו מתחילים. הפרטים משתנים, התוצאה לא — פחות עבודה ידנית, יותר זמן בחזרה.
      </p>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {automateTiles.map((tile, i) => (
          <div class="reveal rounded-2xl border border-border-subtle bg-surface-900 p-6" style={`--reveal-delay: ${100 + i * 80}`}>
            <h3 class="text-lg font-semibold text-text-primary">{tile.title}</h3>
            <p class="mt-2 text-text-muted">{tile.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <ProcessBlock
    heading="איך העבודה איתנו נראית"
    steps={processSteps}
  />

  <!-- FAQ -->
  <FAQBlock heading="שאלות נפוצות" items={faq} />

  <!-- CONTACT FORM -->
  <ContactForm
    heading="לא בטוחים מאיפה להתחיל? בדיוק לזה השיחה הראשונה."
    source="automations-he"
    fields={automationFormFields}
    reassurance="בדרך כלל נחזור אליכם תוך 24 שעות."
    submitLabel="בואו נדבר"
    loadingText="שולחים..."
    successText="קיבלנו, נחזור אליכם בהקדם."
    turnstileHint="הגנת בוטים עדיין לא הוגדרה."
    challengeErrorText="יש להשלים את אימות האבטחה לפני שליחה."
    contactMethodLabel="איך נוח לכם שנחזור אליכם?"
    contactMethods={[
      { id: "email", label: "אימייל" },
      { id: "phone", label: "טלפון" },
      { id: "telegram", label: "טלגרם" },
      { id: "whatsapp", label: "ווטסאפ" },
    ]}
    contactDetailsRequiredText="צריך למלא פרטי קשר עבור הערוץ שבחרתם."
    contactDetailsPlaceholders={{
      email: "",
      phone: "מספר טלפון (כולל קידומת)",
      telegram: "שם משתמש בטלגרם (עם @)",
      whatsapp: "מספר ווטסאפ (כולל קידומת)",
    }}
  />
</Layout>
