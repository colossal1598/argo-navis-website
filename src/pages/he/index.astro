---
/*
  PAGE GOAL: Hebrew homepage mirror. Same shared components as
  src/pages/index.astro, RTL via dir="rtl" + locale="he" on Layout.
  No hand-copied markup. SECTION ORDER (owner decision 2026-08-26,
  "נכון יותר לזרימה של העמוד"): Hero -> VisionSection ->
  AchievementsStrip + QuotesStrip -> StepsSection -> ContactForm.
  Vision sits ABOVE the strips. This started as HE-only; on 2026-08-27
  the EN homepage was aligned to the SAME order and copy (owner:
  "אותו הדבר באנגלית"), so the two pages mirror again — this page is
  now the copy source, EN translates from it. Background rhythm
  alternates cleanly: 950 (hero) -> 800 (vision, tonal step) ->
  900 (strips+quotes merged block) -> 950 (steps/contact).

  Copy source: .apm/memory/copy/he/homepage-he.md — re-read that file
  before editing any string below; it is the approved source of truth,
  not this file. That file's inline `*[תיקון: ...]*`/`*[polish: ...]*`
  markers are editorial review meta for the owner — never rendered
  here; only the resolved text they annotate is used. Draft-quality
  Hebrew copy is acceptable (owner sharpens post-launch) — but zero
  placeholder markers may remain in the built page.

  Numbers are identical to the EN homepage (src/pages/index.astro) and
  exact — never adjusted, rounded, or invented (see CLAUDE.md, Content
  honesty). Three strips only (fuel, travel, marketing) — the
  Reception strip was deleted from the EN page per an explicit
  2026-08-04 owner decision and that decision applies here too.

  This file replaces the OLD pre-remake HE homepage entirely (it used
  to hand-copy Hero/WhyUs/ServicesSection markup for a different page
  structure) — rebuilt on the same shared components the EN homepage
  uses, just with Hebrew copy passed via props.
*/
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import AchievementsStrip from "../../components/AchievementsStrip.astro";
import QuotesStrip from "../../components/QuotesStrip.astro";
import VisionSection from "../../components/VisionSection.astro";
import StepsSection from "../../components/StepsSection.astro";
import ContactForm from "../../components/ContactForm.astro";

/* ACHIEVEMENT STRIPS — same three case studies, same tone-per-strip and
   same real numbers as the EN homepage, Hebrew copy from homepage-he.md.
   Links point at the /he/-prefixed mirrors of the same case-study pages. */
const strips = [
  {
    heading: "עסק משפחתי להפצת דלק",
    subline: "שבוע אחד, מאפס: הגיליונות הוחלפו במערכת שמנהלת את כל התפעול.",
    tone: "brand" as const,
    stats: [
      { value: "21 ← 1",     description: "עשרים ואחד גיליונות אקסל, הוחלפו במערכת אחת שנבנתה סביב העסק." },
      { value: "כ-1,900",    description: "רשומות משלוח שנפרשו והותאמו במהלך המחקר על איך העסק באמת פעל." },
      { value: "₪0 לחודש",   description: "עלות תשתית. רץ כולו על אירוח בשכבת חינם, בלי חשבון שרת, אף פעם." },
    ],
    href:      "/he/systems/fuel-distribution",
    linkLabel: "לסיפור המלא",
  },
  {
    heading: "סוכנות נסיעות",
    subline: "שתי מערכות בהתאמה אישית: פורטל כלים פנימי ואוטומציה בוואטסאפ, כולל ממשק ייעודי.",
    tone: "gold" as const,
    stats: [
      { value: "2",              description: "מערכות בהתאמה אישית: פורטל כלים פנימי ותיבת וואטסאפ שנבנתה מאפס." },
      { value: "8",               description: "אוטומציות פעילות, מהודעת \"לא זמין\" מותאמת ועד ניהול חברות לקוחות ורישום כרטיסים לפי נתוני חיוב." },
      { value: "כ-10 שעות בשבוע", description: "נחסכות בהקלדת הודעות, העברת מידע ועבודה ידנית." },
    ],
    href:      "/he/automations/travel-agency",
    linkLabel: "לסיפור המלא",
  },
  {
    heading: "חברת שיווק דיגיטלי",
    subline: "תכנון תוכן, עבודת מכירות, בקרה פיננסית וגיוס: הכול במעקב ואוטומטי.",
    tone: "slate" as const,
    stats: [
      { value: "6 ← 1",      description: "כלים נפרדים לתוכן, מכירות, כספים וגיוס (מפלטפורמות הודעות ורשימות כתובות ביד), עכשיו במקום אחד." },
      { value: "20+ אנשים",  description: "נציגי מכירות, עובדים וצוות גיוס שמשתמשים במערכת יום-יום." },
      { value: "כ-56,000$",  description: "נחסכו בשנה אחת, ממכירות אבודות, לקוחות שעזבו, ובקרת ניהול טובה יותר." },
    ],
    href:      "/he/systems/marketing-agency",
    linkLabel: "לסיפור המלא",
  },
];

/* CLIENT QUOTES — real client WhatsApp/recommendation messages, published
   VERBATIM (zero editing, per owner decision 2026-08-26) — original
   wording, spelling, and run-on style preserved as received, no em
   dashes. No attribution published by design. Source of truth + notes:
   .apm/memory/copy/he/homepage-he.md. */
const clientQuotes = [
  "אחרי שבדקנו לא מעט הצעות מחיר, הוא נתן לנו מחיר הוגן וזול משמעותית ביחס לכל מה שמצאנו, מבלי להתפשר לרגע על איכות העבודה.",
  "תמיד זמין, עונה במהירות לכל שאלה, בודק כל פרט קטן, ומלווה אותנו יד ביד לאורך כל התהליך. הרגשנו שיש לנו שותף אמיתי שאכפת לו שהכל יעבוד בצורה מושלמת.",
  "התוכנה עצמה עלתה על כל הציפיות שלנו. היא נוחה מאוד לשימוש, מהירה, מסודרת, אינטואיטיבית, ומכילה פתרונות שלא חשבנו עליהם בכלל.",
  "איזה כיף התוכנה הזאת ממש מרגיש כאילו עלינו ליגה 😅",
  "וואי התוכנה הזאת שבנית לנו עשתה לי חיים קלים לגמרי הכל מסודר מול העיניים באמת עפנו עליה",
];

/* VISION / ATTITUDE — no heading in the approved copy, don't add one.
   rewritten 2026-08-26: owner draft, sharpened; AI paragraph bridged to
   the fit-what-helps principle. */
const visionParagraphs = [
  "הרבה עסקים קטנים עדיין מתנהלים כמו לפני עשרים שנה: מטלות ידניות שחוזרות על עצמן כל יום, אקסל מסובך במקרה הטוב, והחלטות שמתקבלות מתחושת בטן במקום מנתונים.",
  "אנחנו מתקנים את זה ועושים איתכם סדר בעזרת טכנולוגיה: מתאימים לעסק בדיוק את מה שיעזור לו לצמוח, והנתונים והמערכת נשארים בבעלות שלכם.",
  "אותו עיקרון תקף גם ל-AI: איפה שהוא באמת חוסך זמן, נשתמש בו, ממוקד ולמשימה אמיתית. איפה שלא, לא נדחוף אותו בכוח.",
];

/* WAY OF WORKING — the 3 one-liners were replaced 2026-08-26 by the
   owner's full 5-stage process (אבחון → איפיון → בנייה → השקה → ליווי). */
const wayOfWorkingSteps = [
  {
    label:       "אבחון",
    description: "נשמע ונשאל אתכם על העסק כדי לקבל תמונת מצב ברורה. תכנון ראשוני, ערך אמיתי בשבילכם.",
  },
  {
    label:       "איפיון",
    description: "כמה שיחות שבהן נכנסים לעובי הקורה: תסבירו לנו לעומק על התהליך שלכם, נרד יחד לפרטים הקטנים כדי לדייק את התכנון כמה שאפשר.",
  },
  {
    label:       "בנייה",
    description: "בדרך כלל שבועיים-שלושה של עבודה מהצד שלנו, בתקשורת מלאה ועם פידבק לאורך הדרך.",
  },
  {
    label:       "השקה",
    description: "המערכת באוויר, עובדת במלואה ומשתלבת חלק בשגרת העבודה שלכם.",
  },
  {
    label:       "ליווי",
    description: "תקופה מוסכמת מראש שבה אנחנו מלטשים ומבצעים את השינויים הקטנים שצצים, כדי שהחוויה שלכם תהיה מושלמת.",
  },
];

/* CONTACT FORM — Hebrew field/UI copy. Same shape as the EN default
   fields (name/email/website/message), same generic Hebrew UI strings
   used across every other HE page (loadingText, successText,
   turnstileHint, contact-method labels/placeholders) — ContactForm.astro
   has no locale-aware defaults of its own, so every HE page must pass
   these explicitly. */
const fields = [
  {
    id: "name",
    label: "שם מלא",
    type: "text" as const,
    placeholder: "איך קוראים לך?",
    required: true,
  },
  {
    id: "email",
    label: "אימייל",
    type: "email" as const,
    placeholder: "you@company.com",
    required: true,
  },
  {
    id: "website",
    label: "אתר",
    type: "url" as const,
    placeholder: "example.com",
    required: false,
  },
  {
    id: "message",
    label: "מה תרצו שנשפר?",
    type: "textarea" as const,
    placeholder: "תארו בקצרה מה לא עובד היום",
    required: true,
  },
];
---

<Layout
  title="דף הבית"
  description="Argo Navis בונה מערכת אחת שמחברת את מה שכבר יש לכם, מוציאה את העסק מהגיליונות, ורצה מהטלפון."
  locale="he"
  dir="rtl"
>

  <!-- HERO — general trust/consulting-first headline, approved 2026-08-26, single CTA, zero numbers. -->
  <Hero
    headline="לפני שבונים לכם משהו, אנחנו יושבים להבין איך העסק באמת עובד."
    subline="מערכות, אוטומציות וכלים חכמים לעסקים קטנים — בנויים סביבכם, בבעלותכם. בלי דמי מנוי שרק עולים, בלי התחייבות לספק."
    cta={{ label: "דברו איתנו על העסק שלכם", href: "/he/#contact" }}
  />

  <!-- VISION / ATTITUDE — the editorial "why us" statement. Moved above the
       strips 2026-08-26 (owner: "נכון יותר לזרימה של העמוד"); the EN page
       was aligned to the same order on 2026-08-27. -->
  <VisionSection paragraphs={visionParagraphs} />

  <!-- ACHIEVEMENT STRIPS — one strip per case study, each linking to its full story.
       flushBottom: QuotesStrip right below shares this section's bg-surface-900 and
       closes the border frame itself, so the two read as one continuous proof block. -->
  <AchievementsStrip
    intro="שלושה עסקים אמיתיים, שלוש מערכות שרצות היום. אלו המספרים:"
    strips={strips}
    flushBottom
  />

  <!-- CLIENT QUOTES — real client messages, verbatim; no attribution by design. -->
  <QuotesStrip quotes={clientQuotes} />

  <!-- WAY OF WORKING — five-stage process, owner's full copy per stage. -->
  <StepsSection
    heading="איך אנחנו עובדים"
    steps={wayOfWorkingSteps}
  />

  <!--
    CONTACT — converts to the same diagnostic conversation as every other
    HE page. No source tag defined in the copy file, consistent with EN.
    Heading/subheading/submitLabel generalized 2026-08-26 (trust/consulting
    direction, Excel angle dropped).
  -->
  <ContactForm
    locale="he"
    heading="בואו נדבר על העסק שלכם"
    subheading="שיחה ראשונה בלי התחייבות: מספרים לנו איך העסק מתנהל היום, ואנחנו אומרים בכנות אם יש מה לשפר ומאיפה להתחיל."
    submitLabel="שלחו ונדבר"
    reassurance="בלי מצגת מוכנה מראש. קודם שואלים על העסק שלכם."
    source="landing-he"
    fields={fields}
    loadingText="שולחים..."
    successText="קיבלנו, נחזור אליכם בהקדם."
    turnstileHint="הגנת בוטים עדיין לא הוגדרה."
    challengeErrorText="יש להשלים את אימות האבטחה לפני שליחה."
    contactMethodLabel="איך נוח לכם שנחזור אליכם?"
    contactMethods={[
      { id: "email", label: "אימייל" },
      { id: "phone", label: "טלפון" },
      { id: "telegram", label: "טלגרם" },
      { id: "whatsapp", label: "ווטסאפ" },
    ]}
    contactDetailsRequiredText="צריך למלא פרטי קשר עבור הערוץ שבחרתם."
    contactDetailsPlaceholders={{
      email: "",
      phone: "מספר טלפון (כולל קידומת)",
      telegram: "שם משתמש בטלגרם (עם @)",
      whatsapp: "מספר ווטסאפ (כולל קידומת)",
    }}
  />

</Layout>
