---
/*
  PAGE GOAL: Hebrew homepage mirror. Mirrors src/pages/index.astro
  section-for-section (Hero -> AchievementsStrip -> VisionSection ->
  StepsSection -> ContactForm), same shared components, RTL via
  dir="rtl" + locale="he" on Layout. No hand-copied markup.

  Copy source: .apm/memory/copy/he/homepage-he.md — re-read that file
  before editing any string below; it is the approved source of truth,
  not this file. That file's inline `*[תיקון: ...]*`/`*[polish: ...]*`
  markers are editorial review meta for the owner — never rendered
  here; only the resolved text they annotate is used. Draft-quality
  Hebrew copy is acceptable (owner sharpens post-launch) — but zero
  placeholder markers may remain in the built page.

  Numbers are identical to the EN homepage (src/pages/index.astro) and
  exact — never adjusted, rounded, or invented (see CLAUDE.md, Content
  honesty). Three strips only (fuel, travel, marketing) — the
  Reception strip was deleted from the EN page per an explicit
  2026-08-04 owner decision and that decision applies here too.

  This file replaces the OLD pre-remake HE homepage entirely (it used
  to hand-copy Hero/WhyUs/ServicesSection markup for a different page
  structure) — rebuilt on the same shared components the EN homepage
  uses, just with Hebrew copy passed via props.
*/
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import AchievementsStrip from "../../components/AchievementsStrip.astro";
import VisionSection from "../../components/VisionSection.astro";
import StepsSection from "../../components/StepsSection.astro";
import ContactForm from "../../components/ContactForm.astro";

/* ACHIEVEMENT STRIPS — same three case studies, same tone-per-strip and
   same real numbers as the EN homepage, Hebrew copy from homepage-he.md.
   Links point at the /he/-prefixed mirrors of the same case-study pages. */
const strips = [
  {
    heading: "עסק משפחתי להפצת דלק",
    subline: "שבוע אחד, מאפס — הגיליונות הוחלפו במערכת שמנהלת את כל התפעול.",
    tone: "brand" as const,
    stats: [
      { value: "21 ← 1",     description: "עשרים ואחד גיליונות אקסל, הוחלפו במערכת אחת שנבנתה סביב העסק." },
      { value: "כ-1,900",    description: "רשומות משלוח שנפרשו והותאמו במהלך המחקר על איך העסק באמת פעל." },
      { value: "₪0 לחודש",   description: "עלות תשתית. רץ כולו על אירוח בשכבת חינם — בלי חשבון שרת, אף פעם." },
    ],
    href:      "/he/systems/fuel-distribution",
    linkLabel: "לקרוא את כל הסיפור",
  },
  {
    heading: "סוכנות נסיעות, שתי מערכות שנבנו ברצף",
    subline: "שתי מערכות בהתאמה אישית: פורטל כלים פנימי ואוטומציה בוואטסאפ, כולל ממשק ייעודי.",
    tone: "gold" as const,
    stats: [
      { value: "2",              description: "מערכות בהתאמה אישית: פורטל כלים פנימי ותיבת וואטסאפ שנבנתה מאפס." },
      { value: "8",               description: "אוטומציות פעילות — מהודעת \"לא זמין\" מותאמת ועד ניהול חברות לקוחות ורישום כרטיסים לפי נתוני חיוב." },
      { value: "כ-10 שעות בשבוע", description: "נחסכות בהקלדת הודעות, העברת מידע ועבודה ידנית." },
    ],
    href:      "/he/automations/travel-agency",
    linkLabel: "לקרוא את כל הסיפור",
  },
  {
    heading: "חברת שיווק דיגיטלי — מערכת אחת מאורגנת במקום בלגן",
    subline: "תכנון תוכן, עבודת מכירות, בקרה פיננסית וגיוס — הכול במעקב ואוטומטי.",
    tone: "slate" as const,
    stats: [
      { value: "6 ← 1",      description: "כלים נפרדים לתוכן, מכירות, כספים וגיוס — מפלטפורמות הודעות ורשימות כתובות ביד — עכשיו במקום אחד." },
      { value: "20+ אנשים",  description: "נציגי מכירות, עובדים וצוות גיוס שמשתמשים במערכת יום-יום." },
      { value: "כ-56,000$",  description: "נחסכו בשנה אחת, ממכירות אבודות, לקוחות שעזבו, ובקרת ניהול טובה יותר." },
    ],
    href:      "/he/systems/marketing-agency",
    linkLabel: "לקרוא את כל הסיפור",
  },
];

/* VISION / ATTITUDE — no heading in the approved copy, don't add one. */
const visionParagraphs = [
  "הרבה עסקים קטנים עדיין מתנהלים כמו לפני עשרים שנה — גיליון אקסל שרק אדם אחד מבין, פנקס לכל השאר, ערב בחודש שהולך לאיבוד על ההתאמות ביניהם. זו לא בעיה טכנולוגית. זה פשוט מה שקורה כשלאף אחד לא היה זמן לתקן את זה.",
  "אנחנו מתקנים את זה בלי למכור לכם עוד תוכנה שצריך לנהל. אתם הבעלים של הנתונים שלכם ושל המערכת שלכם — בלי דמי חודש שרק עולים, בלי ספק שאי אפשר לעזוב, בלי חוזה ארגוני שנבנה לעסק גדול פי עשרים מכם.",
  "במקום שבו AI באמת חוסך זמן, אנחנו משתמשים בו — צר, מדויק, למשימה אמיתית אחת. איפה שהוא לא — אנחנו לא דוחפים אותו בכוח.",
];

/* WAY OF WORKING — depth on each step lives on the service pages. */
const wayOfWorkingSteps = [
  {
    label:       "אבחון קודם.",
    description: "מבט קצר וזול על איפה הזמן והכסף דולפים.",
  },
  {
    label:       "אז בונים.",
    description: "הנתונים שלכם עוברים פנימה, מתחברים למה שאתם משתמשים בו, רצים מהטלפון.",
  },
  {
    label:       "אז נשארים זמינים.",
    description: "שינויים לפי הצורך, גיבויים אוטומטיים, מספר אחד להתקשר אליו.",
  },
];

/* CONTACT FORM — Hebrew field/UI copy. Same shape as the EN default
   fields (name/email/website/message), same generic Hebrew UI strings
   used across every other HE page (loadingText, successText,
   turnstileHint, contact-method labels/placeholders) — ContactForm.astro
   has no locale-aware defaults of its own, so every HE page must pass
   these explicitly. */
const fields = [
  {
    id: "name",
    label: "שם מלא",
    type: "text" as const,
    placeholder: "איך קוראים לך?",
    required: true,
  },
  {
    id: "email",
    label: "אימייל",
    type: "email" as const,
    placeholder: "you@company.com",
    required: true,
  },
  {
    id: "website",
    label: "אתר",
    type: "url" as const,
    placeholder: "example.com",
    required: false,
  },
  {
    id: "message",
    label: "מה תרצו שנשפר?",
    type: "textarea" as const,
    placeholder: "תארו בקצרה מה לא עובד היום",
    required: true,
  },
];
---

<Layout
  title="דף הבית"
  description="Argo Navis בונה מערכת אחת שמחברת את מה שכבר יש לכם, מוציאה את העסק מהגיליונות, ורצה מהטלפון."
  locale="he"
  dir="rtl"
>

  <!-- HERO — owner-supplied headline (Hebrew translation), single CTA, zero numbers. -->
  <Hero
    headline="הדבר היחיד שמחזיק את העסק שלכם ביחד זה אתם וגיליון אקסל?"
    subline="אנחנו בונים מערכת אחת שמחברת את מה שכבר יש לכם ורצה מהטלפון. בלי תוכנה חדשה, בלי נעילה לספק."
    cta={{ label: "דברו איתנו על המערכת שלכם", href: "/he/#contact" }}
  />

  <!-- ACHIEVEMENT STRIPS — one strip per case study, each linking to its full story. -->
  <AchievementsStrip
    intro="כמה פרויקטים שעשינו ללקוחות — עסקים אמיתיים, תוצאות אמיתיות."
    strips={strips}
  />

  <!-- VISION / ATTITUDE — the editorial "why us" statement. -->
  <VisionSection paragraphs={visionParagraphs} />

  <!-- WAY OF WORKING — three compact one-liners. -->
  <StepsSection
    heading="איך אנחנו עובדים"
    steps={wayOfWorkingSteps}
  />

  <!--
    CONTACT — converts to the same diagnostic conversation as every other
    HE page. No source tag defined in the copy file, consistent with EN.
  -->
  <ContactForm
    heading="עדיין עושים את זה ביד?"
    subheading="אם גיליון אקסל, פנקס, או הזיכרון שלכם מחזיקים חלק מהעסק ביחד — זו בדיוק השיחה ששווה לקיים. ספרו לנו איך הדברים מתנהלים היום — נגיד לכם בכנות אם שווה לתקן ומאיפה להתחיל."
    submitLabel="התחילו בשיחת אבחון"
    reassurance="בלי מצגת מוכנה מראש. קודם שואלים על העסק שלכם."
    source="landing-he"
    fields={fields}
    loadingText="שולחים..."
    successText="קיבלנו, נחזור אליכם בהקדם."
    turnstileHint="הגנת בוטים עדיין לא הוגדרה."
    challengeErrorText="יש להשלים את אימות האבטחה לפני שליחה."
    contactMethodLabel="איך נוח לכם שנחזור אליכם?"
    contactMethods={[
      { id: "email", label: "אימייל" },
      { id: "phone", label: "טלפון" },
      { id: "telegram", label: "טלגרם" },
      { id: "whatsapp", label: "ווטסאפ" },
    ]}
    contactDetailsRequiredText="צריך למלא פרטי קשר עבור הערוץ שבחרתם."
    contactDetailsPlaceholders={{
      email: "",
      phone: "מספר טלפון (כולל קידומת)",
      telegram: "שם משתמש בטלגרם (עם @)",
      whatsapp: "מספר ווטסאפ (כולל קידומת)",
    }}
  />

</Layout>
