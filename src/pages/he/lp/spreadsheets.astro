---
/*
  PAGE GOAL (HE): mirrors /lp/spreadsheets exactly, section for section,
  via the same shared components (LandingLayout, LPHero, ChecklistSection,
  ProofSection, ContactForm) — no hand-copied markup, no nav chrome.
  Draft-quality Hebrew copy is acceptable (the owner sharpens
  post-launch). Source tag: lp-spreadsheets-he (existing leads.ts key).

  Copy source: C:\Users\Eyal\Documents\Obsidian\My Vault\שיווק\מאושרים\
  spreadsheets — האקסל שירת אתכם נאמנה.md (owner-approved, supersedes
  .apm/memory/copy/he/lp-spreadsheets-he.md) — re-read that file before
  editing any string below; it is the approved source of truth.

  INTEGRATION NOTE (same constraint as the EN page, see lp-pattern.md):
  email added (backend-required, not in the approved copy); phone/
  WhatsApp via ContactForm's contact-method picker (WhatsApp-first,
  matching this page's WhatsApp-heavy angle); "business type" + "pain
  point" combined into one required message textarea.
*/
import LandingLayout from "../../../layouts/LandingLayout.astro";
import LPHero from "../../../components/LPHero.astro";
import ChecklistSection from "../../../components/ChecklistSection.astro";
import ProofSection from "../../../components/ProofSection.astro";
import ContactForm from "../../../components/ContactForm.astro";

const painItems = [
  { label: "גיליון אקסל אחד ענק, ורק אתם באמת מבינים אותו." },
  { label: "בכל סוף חודש, ערב שלם על התאמת חשבוניות לשורות בגיליון, ביד." },
  { label: "צ'ק שנשכח, חשבונית שלא יצאה, חידוש רישיון שפספסתם. וכל אחד מהם עלה לכם בכסף." },
  { label: "ההזמנות נכנסות בוואטסאפ. אתם מעתיקים אותן לגיליון בעצמכם, אחר כך, אם נזכרים." },
];

const changesItems = [
  { label: "הנתונים שלכם עוברים פנימה. הכל.", description: "כל שורה, כל חודש קודם. שום דבר לא נזרק." },
  { label: "מערכת אחת במקום חמש לשוניות פתוחות.", description: "בלי לקפוץ בין הגיליון של החודש הזה לזה של החודש שעבר בשביל שאלה פשוטה." },
  { label: "מה שכבר יש לכם מתחבר, לא מוחלף.", description: "מורנינג, וואטסאפ, מה שלא יהיה. במקום שאתם תהיו אלה שמעתיקים ביניהם." },
  { label: "זה רץ מהטלפון.", description: "כי שם אתם באמת נמצאים רוב היום, לא ליד שולחן." },
];

const fields = [
  { id: "name", label: "השם שלכם", type: "text" as const, placeholder: "איך קוראים לכם?", required: true },
  { id: "email", label: "אימייל", type: "email" as const, placeholder: "you@business.com", required: true },
  {
    id:          "message",
    label:       "מה העסק שלכם עושה, ומה אוכל לכם הכי הרבה זמן כרגע?",
    type:        "textarea" as const,
    placeholder: "לדוגמה: הפצת דלק. ציינו מה אוכל הכי הרבה זמן, אם תרצו.",
    required:    true,
  },
];

const contactMethods = [
  { id: "whatsapp" as const, label: "וואטסאפ" },
  { id: "phone" as const, label: "טלפון" },
  { id: "email" as const, label: "אימייל" },
  { id: "telegram" as const, label: "טלגרם" },
];
---

<LandingLayout
  title="האקסל שירת אתכם נאמנה. עכשיו הוא הפך לעבודה שנייה."
  description="אנחנו מעבירים את כל מה שהוא מחזיק למערכת אחת שרצה גם מהטלפון. שום דבר לא הולך לאיבוד, הכל עובד לפי השיטה שלכם."
  locale="he"
  dir="rtl"
>

  <!-- HERO -->
  <LPHero
    headline="האקסל שירת אתכם נאמנה. עכשיו הוא הפך לעבודה שנייה."
    subline="אנחנו מעבירים את כל מה שהוא מחזיק למערכת אחת שרצה גם מהטלפון. שום דבר לא הולך לאיבוד, הכל עובד לפי השיטה שלכם."
  />

  <!-- PAIN -->
  <ChecklistSection
    intro="תזהו לפחות אחד מאלה:"
    items={painItems}
    tone="tonal"
  />

  <!-- WHAT CHANGES -->
  <ChecklistSection
    heading="מה משתנה"
    items={changesItems}
  />

  <!-- PROOF -->
  <ProofSection
    text="עשינו בדיוק את זה לעסק משפחתי להפצת דלק: 21 גיליונות חודשיים, הוחלפו במערכת עובדת אחת תוך שבוע פיתוח אחד. ~1,900 רשומות משלוח שהועברו פנימה, כל המידע מסודר ונגיש."
    caseStudyHref="/he/systems/fuel-distribution"
    caseStudyLabel="קייס סטאדי מלא: מאקסל כאוטי למערכת ניהול מלאה בשבוע אחד ←"
  />

  <!-- START THE CONVERSATION -->
  <ContactForm
    heading="עדיין עובדים ידנית? בואו נסתכל על זה ביחד."
    subheading="משאירים פרטים, חוזרים אליכם תוך 24 שעות לשיחה קצרה על איך הגיליון שלכם באמת עובד היום. בלי מצגת מוכנה מראש. קודם שואלים, ואז אומרים בכנות מה שווה לתקן."
    fields={fields}
    contactMethods={contactMethods}
    submitLabel="לתיאום שיחה קצרה"
    reassurance="בלי עלות ובלי התחייבות. רק מבט כן על איך העסק רץ היום."
    source="lp-spreadsheets-he"
    loadingText="שולחים..."
    successText="קיבלנו, נחזור אליכם בהקדם."
    turnstileHint="הגנת בוטים עדיין לא הוגדרה."
    challengeErrorText="יש להשלים את אימות האבטחה לפני שליחה."
    contactMethodLabel="איך נוח לכם שנחזור אליכם?"
    contactDetailsRequiredText="צריך למלא פרטי קשר עבור הערוץ שבחרתם."
    contactDetailsPlaceholders={{
      email: "",
      phone: "מספר טלפון (כולל קידומת)",
      telegram: "שם משתמש בטלגרם (עם @)",
      whatsapp: "מספר ווטסאפ (כולל קידומת)",
    }}
  />

</LandingLayout>
