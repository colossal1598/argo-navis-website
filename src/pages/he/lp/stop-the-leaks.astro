---
/*
  PAGE GOAL (HE, campaign LP): Meta ads → owner who knows manual
  management leaks real money (forgotten checks, missed invoices,
  unanswered calls, open debts) leaves details → short free call →
  paid אבחון credited against the project. One conversion action:
  the form. HE only, no EN mirror.

  Copy source: .apm/memory/copy/he/lp-stop-the-leaks-he.md — re-read
  that file before editing any string below; it is the approved source
  of truth.

  PRICE NOTE: the אבחון price is deliberately not shown yet. When the
  owner fixes a ₪ figure, replace the step-3 description with:
  "עוברים על התהליכים אחד-אחד, ויוצאים עם תמונה ברורה של מה שווה לבנות
  ומה לא. בלי הפתעות: האבחון עולה ₪X, והסכום מתקזז מול הפרויקט אם
  ממשיכים."

  Section order (bg alternation): Hero → Pain (tonal 800) → Changes
  (base 950) → Steps (tonal 800) → Proof (900) → Form (950).
*/
import LandingLayout from "../../../layouts/LandingLayout.astro";
import LPHero from "../../../components/LPHero.astro";
import ChecklistSection from "../../../components/ChecklistSection.astro";
import ProofSection from "../../../components/ProofSection.astro";
import ContactForm from "../../../components/ContactForm.astro";

const painItems = [
  { label: "צ'ק שנשכח במגירה, חשבונית שלא הספקתם להוציא, רישיון שפג בלי ששמתם לב — כל אחד מהם עולה לכם כסף." },
  { label: "שיחה שלא נענתה לא מצלצלת פעמיים. הלקוח פשוט מתקשר לבא בתור." },
  { label: "הזמנה שנרשמה לא נכון, או שלא נרשמה בכלל — כי היא נכנסה באמצע יום עמוס." },
  { label: "חוב פתוח שמתגלגל חודשיים, כי אין מי שיזכור לרדוף אחריו." },
];

const changesItems = [
  { label: "שום דבר לא תלוי בזיכרון.", description: "תזכורות, מעקבים וסטטוסים — המערכת זוכרת במקומכם." },
  { label: "שיחה שלא נענתה מקבלת מענה.", description: "תשובת וואטסאפ אוטומטית מהמספר של העסק עצמו, ברגע שהשיחה מוחמצת. זו לא תיאוריה — זה כבר עובד אצל לקוחות שלנו." },
  { label: "החשבוניות מסתנכרנות לבד.", description: "חיבור ישיר למורנינג או חשבונית ירוקה — בלי חשבונית שנשכחה, בלי כפילויות, בלי התאמות ידניות בסוף החודש." },
  { label: "חובות פתוחים במבט אחד.", description: "מי חייב, כמה, ומתי דיברתם איתו לאחרונה — במקום לגלות בסוף רבעון." },
];

const stepsItems = [
  { label: "משאירים פרטים כאן למטה.", description: "שם, איך נוח לחזור אליכם, ומשפט על העסק. פחות מדקה." },
  { label: "שיחה קצרה, ללא תשלום.", description: "רבע שעה על איך העסק רץ היום. בלי נאום מכירות מוכן מראש — קודם שואלים." },
  { label: "אם יש מה לתקן — אבחון בתשלום.", description: "עוברים על התהליכים אחד-אחד, ויוצאים עם תמונה ברורה של מה שווה לבנות ומה לא. בלי הפתעות: המחיר נאמר מראש, ומתקזז מול הפרויקט אם ממשיכים." },
];

const fields = [
  { id: "name", label: "השם שלכם", type: "text" as const, placeholder: "איך קוראים לכם?", required: true },
  { id: "email", label: "אימייל", type: "email" as const, placeholder: "you@business.com", required: true },
  {
    id:          "message",
    label:       "מה העסק עושה, ואיפה אתם מרגישים שהולך כסף לאיבוד?",
    type:        "textarea" as const,
    placeholder: "לדוגמה: קבלן שיפוצים. בטוח ששכחתי לחייב על עבודות.",
    required:    true,
  },
];

const contactMethods = [
  { id: "whatsapp" as const, label: "וואטסאפ" },
  { id: "phone" as const, label: "טלפון" },
  { id: "email" as const, label: "אימייל" },
  { id: "telegram" as const, label: "טלגרם" },
];
---

<LandingLayout
  title="הכסף לא נעלם בבת אחת. הוא מטפטף מהסדקים."
  description="צ'ק שנשכח, חשבונית שלא יצאה, שיחה שלא נענתה. כל אחד מהם קטן. ביחד — הם משכורת חודשית."
  locale="he"
  dir="rtl"
>

  <!-- HERO -->
  <LPHero
    headline="הכסף לא נעלם בבת אחת. הוא מטפטף מהסדקים."
    subline="צ'ק שנשכח, חשבונית שלא יצאה, שיחה שלא נענתה. כל אחד מהם קטן. ביחד — הם משכורת חודשית."
  />

  <!-- PAIN -->
  <ChecklistSection
    intro="איפה זה מטפטף אצלכם:"
    items={painItems}
    tone="tonal"
  />

  <!-- WHAT CHANGES -->
  <ChecklistSection
    heading="מה משתנה"
    items={changesItems}
  />

  <!-- HOW IT WORKS — the funnel, paid אבחון stated openly -->
  <ChecklistSection
    heading="איך זה עובד"
    items={stepsItems}
    tone="tonal"
  />

  <!-- PROOF -->
  <ProofSection
    text="לא הערכה — מדידה בפועל: סוכנות שיווק דיגיטלית עם יותר מ-20 אנשים איחדה שישה כלים נפרדים למערכת אחת, ומדדה חיסכון של כ-$56,000 בשנה אחת, ממכירות שהפסיקו ליפול בין הכיסאות ומלקוחות שלא נטשו."
    caseStudyHref="/he/systems/marketing-agency"
    caseStudyLabel="איך זה נראה מבפנים ←"
  />

  <!-- START THE CONVERSATION -->
  <ContactForm
    heading="בואו נמצא את הסדקים."
    subheading="משאירים פרטים, חוזרים אליכם תוך 24 שעות בימי עסקים לשיחה קצרה."
    fields={fields}
    contactMethods={contactMethods}
    submitLabel="לתיאום שיחה קצרה"
    reassurance="השיחה הראשונה ללא תשלום ובלי התחייבות. אם יתקדם לאבחון בתשלום — תדעו את זה, ואת המחיר, מראש."
    source="lp-stop-the-leaks-he"
    loadingText="שולחים..."
    successText="קיבלנו, נחזור אליכם בהקדם."
    turnstileHint="הגנת בוטים עדיין לא הוגדרה."
    challengeErrorText="יש להשלים את אימות האבטחה לפני שליחה."
    contactMethodLabel="איך נוח לכם שנחזור אליכם?"
    contactDetailsRequiredText="צריך למלא פרטי קשר עבור הערוץ שבחרתם."
    contactDetailsPlaceholders={{
      email: "",
      phone: "מספר טלפון (כולל קידומת)",
      telegram: "שם משתמש בטלגרם (עם @)",
      whatsapp: "מספר ווטסאפ (כולל קידומת)",
    }}
  />

</LandingLayout>
