---
/*
  PAGE GOAL (HE): mirrors the rebuilt /websites exactly, section for
  section, via the same shared components (Layout, ProcessBlock,
  FAQBlock, ContactForm) — no hand-copied markup. Rebuilt from the
  approved copy file (previous draft on this page predated the EN
  rebuild — different hero/problem-block wording, no proof point, an
  older rebuild-offer line, a different contact message field). Draft-
  quality Hebrew copy is acceptable (the owner sharpens post-launch).

  Copy source: .apm/memory/copy/he/service-websites-he.md — re-read
  that file before editing any string below; it is the approved source
  of truth, not this file. Source tag: websites-he (existing leads.ts
  key).
*/
import Layout from "../../../layouts/Layout.astro";
import ProcessBlock from "../../../components/ProcessBlock.astro";
import FAQBlock from "../../../components/FAQBlock.astro";
import ContactForm from "../../../components/ContactForm.astro";

const processSteps = [
  { label: "אתם שולחים את האתר", description: "או אומרים שצריך לבנות מאפס" },
  { label: "אנחנו עושים אבחון", description: "מהירות, עיצוב, מסר ומבנה" },
  { label: "מציגים תכנית", description: "היקף ברור ומחיר ברור" },
  { label: "בונים", description: "אתם מעודכנים לאורך כל הדרך" },
  { label: "עולים לאוויר", description: "עם אתר שמייצר תוצאות" },
];

const faq = [
  {
    q: "אני צריך שכבר יהיה לי אתר?",
    a: "לא. אנחנו בונים מאפס בדיוק כמו שאנחנו בונים מחדש.",
  },
  {
    q: "כמה זמן זה לוקח?",
    a: "תלוי בהיקף. אתר נקי של 5 עמודים לוקח 2–3 שבועות. נגיד לכם מראש.",
  },
  {
    q: "מה אתם צריכים ממני?",
    a: "הזמן שלכם לשיחה אחת, הלוגו ונכסי המותג שלכם אם יש לכם, ומשוב כשאנחנו מבקשים. זהו.",
  },
];

const websiteFormFields = [
  { id: "name", label: "שם מלא", type: "text" as const, placeholder: "איך קוראים לך?", required: true },
  { id: "email", label: "אימייל", type: "email" as const, placeholder: "you@company.com", required: true },
  { id: "website", label: "אתר", type: "url" as const, placeholder: "example.com", required: false },
  {
    id:          "message",
    label:       "מה הבעיה?",
    type:        "textarea" as const,
    placeholder: "מה לא עובד, או מה אתם צריכים?",
    required:    true,
  },
];
---

<Layout
  title="אתרים"
  description="אנחנו בונים אתרים שמביאים אנשים פנימה — ובונים מחדש כאלה שדוחפים אותם החוצה."
  locale="he"
  dir="rtl"
>

  <!-- HERO — עימות מכוון, בלי כפתור CTA -->
  <section class="relative overflow-hidden bg-surface-950 px-6 py-section-lg text-start md:py-section-xl">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="reveal text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
        האתר שלכם או עובד בשבילכם, או נגדכם. אין אמצע.
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg text-text-muted" style="--reveal-delay: 80">
        אנחנו בונים אתרים שמביאים אנשים פנימה — ובונים מחדש כאלה שדוחפים אותם החוצה.
      </p>
    </div>
  </section>

  <!-- PROBLEM BLOCK -->
  <section class="bg-surface-900 px-6 py-section-md">
    <div class="mx-auto max-w-3xl space-y-6">
      {[
        "אתר איטי מאבד מבקרים תוך 3 שניות.",
        "עיצוב מבלבל הורג אמון עוד לפני שאמרתם מילה.",
        "עיצוב מיושן אומר לאנשים שהפסקתם לשים לב.",
      ].map((line, i) => (
        <p class="reveal text-2xl font-semibold text-text-primary md:text-3xl" style={`--reveal-delay: ${i * 80}`}>{line}</p>
      ))}
    </div>
  </section>

  <!-- WHAT WE DO — כולל נקודת ההוכחה החדשה (₪0 לחודש בעלות תשתית) -->
  <section class="bg-surface-950 px-6 py-section-md">
    <div class="mx-auto max-w-3xl">
      <p class="reveal text-lg text-text-soft md:text-xl">
        אנחנו בונים אתרים נקיים ומהירים שעושים דבר אחד —{" "}
        <strong class="text-text-primary">הופכים מבקרים ללידים.</strong>{" "}
        בלי עומס, בלי תבניות שנראות כמו של כולם.
      </p>

      <ul class="mt-8 space-y-3">
        {[
          "מהיר ומותאם קודם לנייד",
          "בנוי כדי לדרג בגוגל",
          "מעוצב סביב הלקוח שלכם, לא סביב הטעם שלכם",
        ].map((line, i) => (
          <li class="reveal flex items-start gap-3 text-text-muted" style={`--reveal-delay: ${80 + i * 60}`}>
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-xs bg-brand-400"></span>
            {line}
          </li>
        ))}
      </ul>

      <p class="reveal mt-8 text-text-muted" style="--reveal-delay: 260">
        נקודת הוכחה: אותה גישה של אפס נעילה שבה אנחנו מריצים מערכת עסקית שלמה של לקוח ב-₪0 לחודש בעלות תשתית חלה גם על אתר — בלי דמי אירוח חודשיים מנופחים, בלי ספק שאי אפשר לעזוב.
      </p>
    </div>
  </section>

  <!-- PROCESS -->
  <ProcessBlock
    heading="איך העבודה איתנו נראית"
    steps={processSteps}
  />

  <!-- REBUILD OFFER — ניסוח מרוענן, זהה למבנה ה-EN -->
  <section id="rebuild" class="bg-surface-800 px-6 py-section-lg">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="reveal text-3xl font-bold text-text-primary md:text-4xl">
        נראה לכם איך האתר שלכם יכול להיראות. לפני שאתם מתחייבים לכל דבר.
      </h2>
      <p class="reveal mx-auto mt-5 max-w-xl text-text-muted" style="--reveal-delay: 80">
        שלחו לנו את האתר שלכם. נחזור עם דוגמה אמיתית למה שהיינו משנים — בלי שום התחייבות.
      </p>
      <a href="/he/#contact" class="reveal btn btn-primary btn-lg mt-8" style="--reveal-delay: 160">
        הראו לנו את האתר שלכם
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <FAQBlock heading="שאלות נפוצות" items={faq} />

  <!-- CONTACT FORM -->
  <ContactForm
    heading="יש לכם אתר שלא עושה את העבודה? ספרו לנו."
    source="websites-he"
    fields={websiteFormFields}
    reassurance="בדרך כלל נחזור אליכם תוך 24 שעות."
    submitLabel="בואו נדבר"
    loadingText="שולחים..."
    successText="קיבלנו, נחזור אליכם בהקדם."
    turnstileHint="הגנת בוטים עדיין לא הוגדרה."
    challengeErrorText="יש להשלים את אימות האבטחה לפני שליחה."
    contactMethodLabel="איך נוח לכם שנחזור אליכם?"
    contactMethods={[
      { id: "email", label: "אימייל" },
      { id: "phone", label: "טלפון" },
      { id: "telegram", label: "טלגרם" },
      { id: "whatsapp", label: "ווטסאפ" },
    ]}
    contactDetailsRequiredText="צריך למלא פרטי קשר עבור הערוץ שבחרתם."
    contactDetailsPlaceholders={{
      email: "",
      phone: "מספר טלפון (כולל קידומת)",
      telegram: "שם משתמש בטלגרם (עם @)",
      whatsapp: "מספר ווטסאפ (כולל קידומת)",
    }}
  />
</Layout>
