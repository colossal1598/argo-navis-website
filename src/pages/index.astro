<Layout
  title="Home"
  description="Argo Navis builds one system that connects what you already use, pulls your business out of the spreadsheets, and runs from your phone."
>

  <!-- HERO — owner-supplied headline, finalized round 5 with "together". Single CTA, zero numbers, tightened composition. -->
  <Hero
    headline="The only thing holding your business together is you and a spreadsheet?"
    subline="We build one system that connects what you already use and runs from your phone. No new software, no lock-in."
    cta={{ label: "Talk to us about your setup", href: "#contact" }}
  />

  <!-- ACHIEVEMENT STRIPS — restored round-1 presentation, one strip per case study, each linking to its full story. -->
  <AchievementsStrip
    intro="Real business, real results."
    strips={strips}
  />

  <!-- VISION / ATTITUDE — the editorial "why us" statement. -->
  <VisionSection paragraphs={visionParagraphs} />

  <!-- WAY OF WORKING — three compact one-liners. -->
  <StepsSection
    heading="Way of Working"
    steps={wayOfWorkingSteps}
  />

  <!--
    CONTACT — converts to the same diagnostic conversation as every other
    page. Unchanged from the prior version; no source tag defined on the
    homepage, consistent with earlier drafts.
  -->
  <ContactForm
    heading="Still doing this by hand?"
    subheading="If a spreadsheet, a notebook, or your own memory is holding a piece of your business together, that's exactly the conversation worth having. Tell us how things run today — we'll tell you honestly whether it's worth fixing and where to start."
    submitLabel="Start with a diagnostic conversation"
    reassurance="No pitch prepared in advance. We ask about your business first."
    source="landing"
  />

</Layout>
