      { value: "< 1 min",   description: "How fast the WhatsApp reply goes out after a missed call." },
      // PLACEHOLDER — awaiting owner's real number, DO NOT SHIP (kind: scale — clients running Reception today, or replies sent)
      { value: "6 clients", description: "Running Reception today." },
      // PLACEHOLDER — awaiting owner's real number, DO NOT SHIP (kind: build time — how long Reception took to build)
      { value: "2 weeks",   description: "From first idea to a working, bilingual product." },
    ],
    href:      "/automations/reception",
    linkLabel: "We can build the same for your business",
  },
  {
    heading: "A digital marketing agency — one organized system instead of a mess",
    subline: "Content planning, sales work, financial oversight, and hiring — all tracked and automated.",
    tone: "muted" as const,
    stats: [
      { value: "6 → 1",       description: "Separate tools for content, sales, finance, and hiring — from messaging platforms and written notes — now in one place." },
      { value: "20+ people",  description: "Sales reps, workers, and hiring staff using the system day to day." },
      { value: "~$56,000",    description: "Saved in one year, from lost sales, deserting clients, and better management oversight." },
