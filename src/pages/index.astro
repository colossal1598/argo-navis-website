    stats: [
      { value: "2",               description: "Custom systems built: an internal tools portal and a from-scratch WhatsApp inbox." },
      { value: "8",                description: "Running automations — from an out-of-office custom message to client membership management and ticket registration using billing data." },
      { value: "~10 hours a week", description: "Saved in prompting, relaying information, and manual work." },
