/* VISION / ATTITUDE — unchanged from the prior revision, verified
   word-for-word against the copy file. No heading in the approved
   copy — don't add one. Zero numbers, zero case-study reference. */
const visionParagraphs = [
  "Most small businesses still run the way they did twenty years ago — one spreadsheet only one person understands, a notebook for the rest, an evening a month lost to reconciling them. That's not a technology problem. It's just what happens when nobody's had time to fix it.",
  "We fix it without selling you more software to manage. You own your data and your system — no climbing monthly fees, no vendor you can't leave, no enterprise contract built for a business twenty times your size.",
  "Where AI genuinely saves time, we use it — narrow, precise, for one real job. Where it doesn't, we don't force it in.",
];

/* WAY OF WORKING — unchanged from the prior revision, verified against
   the copy file. Depth on each step lives on the service pages. */
const wayOfWorkingSteps = [
  {
    label:       "Diagnosis first.",
    description: "A short, low-cost look at where the time and money leak.",
  },
  {
    label:       "Then we build.",
    description: "Your data migrates in, connects to what you use, runs from your phone.",
  },
  {
    label:       "Then we stay reachable.",
    description: "Small changes as needed, automatic backups, one person to call.",
