import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import AchievementsStrip from "../components/AchievementsStrip.astro";
import VisionSection from "../components/VisionSection.astro";
import StepsSection from "../components/StepsSection.astro";
import ContactForm from "../components/ContactForm.astro";

/* ACHIEVEMENT STRIPS — one confidently-colored, bordered stats-row
   panel per case study. Every value below is real and traceable to a
   real project (see CLAUDE.md, Content honesty) — as of round 6
   (Reception's deletion) there are no remaining placeholder/invented
   numbers on this page. `tone` picks each strip's panel color — three
   strips, three tones (brand/gold/slate), each used exactly once;
   "muted" is no longer used anywhere on this page (it belonged to
   marketing-agency before Reception's deletion freed up "slate" for
   reassignment). */
const strips = [
  {
    heading: "A family fuel-distribution business",
    subline: "One week, ground up — spreadsheets replaced with a system that runs the whole operation.",
    tone: "brand" as const,
    stats: [
      { value: "21 → 1",      description: "Twenty-one spreadsheets, replaced by one system built around the business." },
      { value: "~1,900",      description: "Delivery records untangled and matched during the investigation into how the business actually operated." },
      { value: "₪0 / month",  description: "Infrastructure cost. Runs entirely on free-tier hosting — no server bill, ever." },
    ],
    href:      "/systems/fuel-distribution",
    linkLabel: "Read the full story",
  },
  {
    heading: "A travel agency, two systems built back to back",
    subline: "Two custom systems: an internal tools portal and WhatsApp automation, including a dedicated interface.",
    tone: "gold" as const,
    stats: [
      { value: "2",               description: "Custom systems built: an internal tools portal and a from-scratch WhatsApp inbox." },
      { value: "8",                description: "Running automations — from an out-of-office custom message to client membership management and ticket registration using billing data." },
      { value: "~10 hours a week", description: "Saved in prompting, relaying information, and manual work." },
    ],
    href:      "/automations/travel-agency",
    linkLabel: "Read the full story",
  },
  {
    heading: "A digital marketing agency — one organized system instead of a mess",
    subline: "Content planning, sales work, financial oversight, and hiring — all tracked and automated.",
    tone: "slate" as const,
    stats: [
      { value: "6 → 1",       description: "Separate tools for content, sales, finance, and hiring — from messaging platforms and written notes — now in one place." },
      { value: "20+ people",  description: "Sales reps, workers, and hiring staff using the system day to day." },
      { value: "~$56,000",    description: "Saved in one year, from lost sales, deserting clients, and better management oversight." },
    ],
    href:      "/systems/marketing-agency",
    linkLabel: "Read the full story",
  },
];

/* VISION / ATTITUDE — unchanged from the prior revision, verified
   word-for-word against the copy file. No heading in the approved
   copy — don't add one. Zero numbers, zero case-study reference. */
const visionParagraphs = [
  "Most small businesses still run the way they did twenty years ago — one spreadsheet only one person understands, a notebook for the rest, an evening a month lost to reconciling them. That's not a technology problem. It's just what happens when nobody's had time to fix it.",
  "We fix it without selling you more software to manage. You own your data and your system — no climbing monthly fees, no vendor you can't leave, no enterprise contract built for a business twenty times your size.",
  "Where AI genuinely saves time, we use it — narrow, precise, for one real job. Where it doesn't, we don't force it in.",
];

/* WAY OF WORKING — unchanged from the prior revision, verified against
   the copy file. Depth on each step lives on the service pages. */
const wayOfWorkingSteps = [
  {
    label:       "Diagnosis first.",
    description: "A short, low-cost look at where the time and money leak.",
  },
  {
    label:       "Then we build.",
    description: "Your data migrates in, connects to what you use, runs from your phone.",
  },
  {
    label:       "Then we stay reachable.",
    description: "Small changes as needed, automatic backups, one person to call.",
  },
];
---

<Layout
  title="Home"
  description="Argo Navis builds one system that connects what you already use, pulls your business out of the spreadsheets, and runs from your phone."
>

  <!-- HERO — owner-supplied headline, finalized round 5 with "together". Single CTA, zero numbers, tightened composition. -->
  <Hero
    headline="The only thing holding your business together is you and a spreadsheet?"
    subline="We build one system that connects what you already use and runs from your phone. No new software, no lock-in."
    cta={{ label: "Talk to us about your setup", href: "#contact" }}
  />

  <!-- ACHIEVEMENT STRIPS — restored round-1 presentation, one strip per case study, each linking to its full story. -->
  <AchievementsStrip
    intro="Some projects we did for clients — real businesses, real results."
    strips={strips}
  />

  <!-- VISION / ATTITUDE — the editorial "why us" statement. -->
  <VisionSection paragraphs={visionParagraphs} />

  <!-- WAY OF WORKING — three compact one-liners. -->
  <StepsSection
    heading="Way of Working"
    steps={wayOfWorkingSteps}
  />

  <!--
    CONTACT — converts to the same diagnostic conversation as every other
    page. Unchanged from the prior version; no source tag defined on the
    homepage, consistent with earlier drafts.
  -->
  <ContactForm
    heading="Still doing this by hand?"
    subheading="If a spreadsheet, a notebook, or your own memory is holding a piece of your business together, that's exactly the conversation worth having. Tell us how things run today — we'll tell you honestly whether it's worth fixing and where to start."
    submitLabel="Start with a diagnostic conversation"
    reassurance="No pitch prepared in advance. We ask about your business first."
    source="landing"
  />

</Layout>
