import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import AchievementsStrip from "../components/AchievementsStrip.astro";
import QuotesStrip from "../components/QuotesStrip.astro";
import VisionSection from "../components/VisionSection.astro";
import StepsSection from "../components/StepsSection.astro";
import ContactForm from "../components/ContactForm.astro";

/* ACHIEVEMENT STRIPS — one confidently-colored, bordered stats-row
   panel per case study. Every value below is real and traceable to a
   real project (see CLAUDE.md, Content honesty) — as of round 6
   (Reception's deletion) there are no remaining placeholder/invented
   numbers on this page. `tone` picks each strip's panel color — three
   strips, three tones (brand/gold/slate), each used exactly once;
   "muted" is no longer used anywhere on this page (it belonged to
   marketing-agency before Reception's deletion freed up "slate" for
   reassignment). */
const strips = [
  {
    heading: "A family fuel-distribution business",
    subline: "One week, from the ground up: spreadsheets replaced with a system that runs the whole operation.",
    tone: "brand" as const,
    stats: [
      { value: "21 → 1",      description: "Twenty-one spreadsheets, replaced by one system built around the business." },
      { value: "~1,900",      description: "Delivery records untangled and matched during the investigation into how the business actually operated." },
      { value: "₪0 / month",  description: "Infrastructure cost. Runs entirely on free-tier hosting, no server bill, ever." },
    ],
    href:      "/systems/fuel-distribution",
    linkLabel: "Full story",
  },
  {
    heading: "A travel agency",
    subline: "Two custom systems: an internal tools portal and WhatsApp automation, including a dedicated interface.",
    tone: "gold" as const,
    stats: [
      { value: "2",               description: "Custom systems built: an internal tools portal and a from-scratch WhatsApp inbox." },
      { value: "8",                description: "Running automations, from a custom out-of-office message to client membership management and ticket registration using billing data." },
      { value: "~10 hours a week", description: "Saved on typing messages, relaying information, and manual work." },
    ],
    href:      "/automations/travel-agency",
    linkLabel: "Full story",
  },
  {
    heading: "A digital marketing agency",
    subline: "Content planning, sales work, financial oversight, and hiring: all tracked and automated.",
    tone: "slate" as const,
    stats: [
      { value: "6 → 1",       description: "Separate tools for content, sales, finance, and hiring (from messaging platforms and handwritten lists), now in one place." },
      { value: "20+ people",  description: "Sales reps, workers, and hiring staff using the system day to day." },
      { value: "~$56,000",    description: "Saved in one year, from lost sales, clients who left, and better management oversight." },
    ],
    href:      "/systems/marketing-agency",
    linkLabel: "Full story",
  },
];

/* CLIENT QUOTES — faithful English translations of the five real,
   verbatim Hebrew client messages published on the HE homepage
   (source of truth: src/pages/he/index.astro + .apm/memory/copy/he/
   homepage-he.md — WhatsApp/recommendation messages received
   2026-08-26, published there with zero editing). The translations
   preserve the meaning exactly, invent nothing, and keep the casual
   register (and the 😅) of the originals. No attribution by design,
   same as HE. */
const clientQuotes = [
  "After comparing quite a few quotes, he gave us a fair price, significantly cheaper than anything else we found, without compromising for a moment on the quality of the work.",
  "Always available, answers every question quickly, checks every little detail, and walks with us hand in hand through the whole process. We felt we had a real partner who cares that everything works perfectly.",
  "The system itself exceeded all our expectations. It is very easy to use, fast, organized, intuitive, and includes solutions we had not even thought of.",
  "This software is such a joy, it really feels like we moved up a league 😅",
  "Wow, this software you built for us has made my life completely easy, everything organized right in front of my eyes, we honestly love it",
];

/* VISION / ATTITUDE — translated 2026-08-27 from the live HE vision
   paragraphs (owner's sharpened draft, 2026-08-26). No heading in the
   approved copy — don't add one. Zero numbers, zero case-study
   reference. No em dashes (owner rule). */
const visionParagraphs = [
  "Many small businesses still run the way they did twenty years ago: manual tasks that repeat every day, a complicated spreadsheet at best, and decisions made on gut feeling instead of data.",
  "We fix that and put things in order with you, using technology: the business gets exactly what will help it grow, and the data and the system stay yours.",
  "The same principle goes for AI: where it genuinely saves time, we use it, focused and for a real job. Where it doesn't, we don't force it in.",
];

/* WAY OF WORKING — the 3 one-liners were replaced 2026-08-27 by the
   owner's full 5-stage process, translated from the live HE steps
   (אבחון / איפיון / בנייה / השקה / ליווי). */
const wayOfWorkingSteps = [
  {
    label:       "Diagnosis",
    description: "We listen and ask about your business to get a clear picture. Initial planning, real value for you.",
  },
  {
    label:       "Specification",
    description: "A few conversations where we get into the details: you explain your process in depth, and together we go through the fine points to make the plan as precise as possible.",
  },
  {
    label:       "Build",
    description: "Usually two to three weeks of work on our side, in full communication and with feedback along the way.",
  },
  {
    label:       "Launch",
    description: "The system is live, fully working and fitting smoothly into your daily routine.",
  },
  {
    label:       "Ongoing care",
    description: "A period agreed in advance where we polish and make the small changes that come up, so your experience is perfect.",
  },
];
---

<Layout
  title="Home"
  description="Argo Navis builds one system that connects what you already use, pulls your business out of the spreadsheets, and runs from your phone."
>

  <!-- HERO — trust/consulting-first headline, translated 2026-08-27 from the owner's live HE hero. Single CTA, zero numbers. -->
  <Hero
    headline="Before we build you anything, we sit down to understand how your business really works."
    subline="Systems, automations, and smart tools for small businesses: built around you, owned by you. No subscription fees that only climb, no vendor lock-in."
    cta={{ label: "Talk to us about your business", href: "#contact" }}
  />

  <!-- VISION / ATTITUDE — the editorial "why us" statement. Above the
       strips since 2026-08-27, mirroring the HE page order (owner:
       "נכון יותר לזרימה של העמוד"). -->
  <VisionSection paragraphs={visionParagraphs} />

  <!-- ACHIEVEMENT STRIPS — one strip per case study, each linking to its full story.
       flushBottom: QuotesStrip right below shares this section's bg-surface-900 and
       closes the border frame itself, so the two read as one continuous proof block. -->
  <AchievementsStrip
    intro="Three real businesses, three systems running today. These are the numbers:"
    strips={strips}
    flushBottom
  />

  <!-- CLIENT QUOTES — faithful translations of real verbatim Hebrew client messages (see the const's comment); no attribution by design. -->
  <QuotesStrip quotes={clientQuotes} />

  <!-- WAY OF WORKING — five-stage process, translated from the owner's full HE copy per stage. -->
  <StepsSection
    heading="How we work"
    steps={wayOfWorkingSteps}
  />

  <!--
    CONTACT — converts to the same diagnostic conversation as every other
    page. Heading/subheading/submitLabel translated 2026-08-27 from the
    live HE contact copy (trust/consulting direction, generalized
    2026-08-26). No source-tag change.
  -->
  <ContactForm
    heading="Let's talk about your business"
    subheading="A first conversation, no commitment: you tell us how the business runs today, and we tell you honestly whether there's something to improve and where to start."
    submitLabel="Send it and we'll talk"
    reassurance="No pitch prepared in advance. We ask about your business first."
    source="landing"
  />

</Layout>
