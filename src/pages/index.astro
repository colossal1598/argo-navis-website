---
/*
  PAGE GOAL: Homepage. REVISED 2026-07-26 per owner redirect — the
  homepage represents the business, its values and basics: "no hard
  numbers, just vibes and vision." Hero and Vision carry ZERO numbers
  and no case-study reference — depth (numbers, proof) lives in a
  dedicated Capability Strips section instead, each strip pairing one
  real fact with a link to where the full story lives. No developer
  metrics anywhere on this page — only business numbers, and only
  inside the strips (see CLAUDE.md, Content honesty).

  Copy source: .apm/memory/copy/homepage-en.md — re-read that file
  before editing any string below; it is the approved source of truth,
  not this file. This supersedes the single-case-study-focused version
  from Task 2.3 — the owner reviewed that build and redirected the
  content structure (craft wasn't the issue, direction was).

  No imagery yet — CapabilityStrips already has an image slot ready for
  the owner's screenshots (sharpening pass); nothing to do here until
  then.
*/
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import CapabilityStrips from "../components/CapabilityStrips.astro";
import VisionSection from "../components/VisionSection.astro";
import StepsSection from "../components/StepsSection.astro";
import ContactForm from "../components/ContactForm.astro";

/* CAPABILITY STRIPS — six real, independently verified facts, each a
   different part of how the business works. Do not add, round, or
   invent a number here without a traceable source. Link targets are
   canonical per the approved copy's header comment. */
const strips = [
  {
    fact:       "21 → 1",
    capability: "Twenty-one spreadsheets, replaced by one custom system built around the business.",
    href:       "/systems/fuel-distribution",
    linkLabel:  "See the system",
  },
  {
    fact:       "1 week",
    capability: "From first meeting to a working system — that's the speed a focused build moves at.",
    href:       "/systems",
    linkLabel:  "How we build",
  },
  {
    fact:       "~1,900 records",
    capability: "Untangled and matched during the investigation into how the business actually operated.",
    href:       "/systems/fuel-distribution",
    linkLabel:  "See the investigation",
  },
  {
    fact:       "~940 documents",
    capability: "Synced automatically between accounting and delivery records — no manual matching, ever.",
    href:       "/automations",
    linkLabel:  "How we connect systems",
  },
  {
    fact:       "₪0 / month",
    capability: "Real infrastructure cost for a live business system. Free-tier hosting, no bloated fees.",
    href:       "/websites",
    linkLabel:  "How we build websites",
  },
  {
    fact:       "Reception",
    capability: "An automatic WhatsApp reply for missed calls — built once, running for clients today.",
    href:       "/ai-agents",
    linkLabel:  "How we use AI",
  },
];

/* VISION / ATTITUDE — tightened to roughly half the prior length per
   the owner's redirect. No heading in the approved copy — don't add
   one. Zero numbers, zero case-study reference. */
const visionParagraphs = [
  "Most small businesses still run the way they did twenty years ago — one spreadsheet only one person understands, a notebook for the rest, an evening a month lost to reconciling them. That's not a technology problem. It's just what happens when nobody's had time to fix it.",
  "We fix it without selling you more software to manage. You own your data and your system — no climbing monthly fees, no vendor you can't leave, no enterprise contract built for a business twenty times your size.",
  "Where AI genuinely saves time, we use it — narrow, precise, for one real job. Where it doesn't, we don't force it in.",
];

/* WAY OF WORKING — compact one-liners now (was a full paragraph each
   in the prior version); depth on each step lives on the service
   pages, not here. */
const wayOfWorkingSteps = [
  {
    label:       "Diagnosis first.",
    description: "A short, low-cost look at where the time and money leak.",
  },
  {
    label:       "Then we build.",
    description: "Your data migrates in, connects to what you use, runs from your phone.",
  },
  {
    label:       "Then we stay reachable.",
    description: "Small changes as needed, automatic backups, one person to call.",
  },
];
---

<Layout
  title="Home"
  description="Argo Navis builds one system that connects what you already use, pulls your business out of the spreadsheets, and runs from your phone."
>

  <!-- HERO — the disconnect the reader already lives with. Single CTA, zero numbers, no case-study reference. -->
  <Hero
    headline="The orders land in WhatsApp. The invoices sit in Morning. You're the only thing connecting them."
    subline="We build one system that connects what you already use, pulls your business out of the spreadsheets, and runs from your phone. No new software to learn. No enterprise contract. No lock-in."
    cta={{ label: "Talk to us about your setup", href: "#contact" }}
  />

  <!-- CAPABILITY STRIPS — every real number on the homepage lives here, each one linked to its full story. -->
  <CapabilityStrips
    intro="Six real facts. Each one is a different part of how we work — click through to see it in context."
    strips={strips}
    note="Each fact is exact and independently verified — no rounding, no estimates. Full stories live behind each link."
  />

  <!-- VISION / ATTITUDE — the editorial "why us" statement, tightened, no numbers. -->
  <VisionSection paragraphs={visionParagraphs} />

  <!-- WAY OF WORKING — three compact one-liners. -->
  <StepsSection
    heading="Way of Working"
    steps={wayOfWorkingSteps}
  />

  <!--
    CONTACT — converts to the same diagnostic conversation as every other
    page. Unchanged from the prior version; no source tag defined on the
    homepage, consistent with earlier drafts.
  -->
  <ContactForm
    heading="Still doing this by hand?"
    subheading="If a spreadsheet, a notebook, or your own memory is holding a piece of your business together, that's exactly the conversation worth having. Tell us how things run today — we'll tell you honestly whether it's worth fixing and where to start."
    submitLabel="Start with a diagnostic conversation"
    reassurance="No pitch prepared in advance. We ask about your business first."
    source="landing"
  />

</Layout>
