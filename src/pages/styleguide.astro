---
/*
  PAGE GOAL: Living style-sheet for the design token system. Not a
  marketing page — an internal reference so every future page/component
  pulls from the same tokens and component classes instead of reinventing
  utility strings. Noindexed (see Layout `noindex` prop) since it has no
  audience-facing purpose.

  Sections below: Colors, Type Scale, Radius, Buttons, Cards, Badges,
  Form Fields, Section Rhythm, Motion, RTL Sample. Toggle dark/light with
  the theme button in the nav above — every section below must hold up
  in both.
*/
import Layout from "../layouts/Layout.astro";

/*
  Tailwind's class scanner needs each full utility class to appear
  literally in the source — `bg-brand-${step}` would NOT be picked up.
  So swatches map each step to its complete, literal class name.
*/
const brandSteps = [
  { step: 50, class: "bg-brand-50" },
  { step: 100, class: "bg-brand-100" },
  { step: 200, class: "bg-brand-200" },
  { step: 300, class: "bg-brand-300" },
  { step: 400, class: "bg-brand-400" },
  { step: 500, class: "bg-brand-500" },
  { step: 600, class: "bg-brand-600" },
  { step: 700, class: "bg-brand-700" },
  { step: 800, class: "bg-brand-800" },
  { step: 900, class: "bg-brand-900" },
];
const goldSteps = [
  { step: 400, class: "bg-gold-400" },
  { step: 500, class: "bg-gold-500" },
  { step: 600, class: "bg-gold-600" },
];
const surfaceSteps = [
  { step: 950, class: "bg-surface-950" },
  { step: 900, class: "bg-surface-900" },
  { step: 800, class: "bg-surface-800" },
  { step: 700, class: "bg-surface-700" },
];
const textTokens = [
  { name: "text-primary", class: "text-text-primary" },
  { name: "text-soft", class: "text-text-soft" },
  { name: "text-muted", class: "text-text-muted" },
];
const radiusSteps = [
  { name: "radius-xs", class: "rounded-xs", px: "2px", use: "fine detail only" },
  { name: "radius-sm", class: "rounded-sm", px: "4px", use: "buttons, inputs, badges" },
  { name: "radius-md", class: "rounded-md", px: "6px", use: "icon buttons, compact tags" },
  { name: "radius-lg", class: "rounded-lg", px: "8px", use: "reserved" },
  { name: "radius-xl", class: "rounded-xl", px: "12px", use: "reserved" },
  { name: "radius-2xl", class: "rounded-2xl", px: "16px", use: "cards, panels" },
];
const sectionRhythm = [
  { name: "section-sm", class: "py-section-sm", px: "64px", replaces: "py-16", use: "compact / tonal-break sections" },
  { name: "section-md", class: "py-section-md", px: "80px", replaces: "py-20", use: "standard content sections" },
  { name: "section-lg", class: "py-section-lg", px: "96px", replaces: "py-24", use: "spacious sections (contact, process)" },
  { name: "section-xl", class: "py-section-xl", px: "144px", replaces: "md:py-36", use: "hero-scale responsive bump" },
];
/*
  Tailwind v4 has no named theme scale for duration (unlike ease/radius/
  spacing) — durations are the plain numeric utilities below. Values
  match the --duration-* custom properties documented in global.css.
*/
const durations = [
  { name: "duration-fast (--duration-fast)", class: "duration-150", ms: "150ms", use: "hover color/border changes" },
  { name: "duration-base (--duration-base)", class: "duration-200", ms: "200ms", use: "card transitions" },
  { name: "duration-slow (--duration-slow)", class: "duration-300", ms: "300ms", use: "menu expand/collapse" },
  { name: "duration-slower (--duration-slower)", class: "duration-500", ms: "500ms", use: "scroll-reveal entrances" },
];
---

<Layout
  title="Style Guide"
  description="Internal design token and component reference."
  noindex={true}
>
  <!-- PAGE HEADER -->
  <section class="border-b border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <p class="badge badge-brand mb-4">Internal / noindexed</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-text-primary md:text-5xl">
        Style Guide
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-text-muted">
        The token set and component classes every page and component should build from.
        Toggle dark / light with the theme button in the nav — everything below must hold
        up in both.
      </p>
    </div>
  </section>

  <!-- COLORS -->
  <section class="px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">Colors</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        Brand blue and gold are fixed hex steps. Surface, text, and border tokens are
        semantic — they remap automatically per <code>data-theme</code>.
      </p>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-widest text-text-muted">Brand</h3>
      <div class="mt-3 grid grid-cols-5 gap-3 sm:grid-cols-10">
        {brandSteps.map(s => (
          <div class="flex flex-col items-center gap-1.5">
            <div class={`h-12 w-full rounded-sm border border-border-subtle ${s.class}`}></div>
            <span class="text-xs text-text-muted">{s.step}</span>
          </div>
        ))}
      </div>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-widest text-text-muted">Gold accent</h3>
      <div class="mt-3 grid grid-cols-5 gap-3 sm:grid-cols-10">
        {goldSteps.map(s => (
          <div class="flex flex-col items-center gap-1.5">
            <div class={`h-12 w-full rounded-sm border border-border-subtle ${s.class}`}></div>
            <span class="text-xs text-text-muted">{s.step}</span>
          </div>
        ))}
      </div>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-widest text-text-muted">Surface steps</h3>
      <div class="mt-3 grid grid-cols-4 gap-3">
        {surfaceSteps.map(s => (
          <div class="flex flex-col items-center gap-1.5">
            <div class={`h-16 w-full rounded-sm border border-border-subtle ${s.class}`}></div>
            <span class="text-xs text-text-muted">surface-{s.step}</span>
          </div>
        ))}
      </div>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-widest text-text-muted">Text tokens</h3>
      <div class="mt-3 flex flex-col gap-2 rounded-sm border border-border-subtle bg-surface-900 p-4">
        {textTokens.map(t => (
          <p class={`text-base ${t.class}`}>{t.name} — the quick brown fox jumps over the lazy dog</p>
        ))}
      </div>
    </div>
  </section>

  <!-- TYPE SCALE -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">Type Scale</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        Font stack: Inter for Latin, Heebo for Hebrew, sharing weights so mixed-language
        pages stay visually even.
      </p>

      <div class="mt-8 flex flex-col gap-6">
        <div>
          <p class="mb-1 text-xs text-text-muted">text-4xl md:text-5xl lg:text-6xl — hero H1</p>
          <p class="text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">Aa Hero headline</p>
        </div>
        <div>
          <p class="mb-1 text-xs text-text-muted">text-3xl md:text-4xl — section H2</p>
          <p class="text-3xl font-bold text-text-primary md:text-4xl">Aa Section heading</p>
        </div>
        <div>
          <p class="mb-1 text-xs text-text-muted">text-xl — card H3</p>
          <p class="text-xl font-semibold text-text-primary">Aa Card title</p>
        </div>
        <div>
          <p class="mb-1 text-xs text-text-muted">text-lg — subline / lead paragraph</p>
          <p class="text-lg text-text-muted">Aa Most businesses leak money through the cracks.</p>
        </div>
        <div>
          <p class="mb-1 text-xs text-text-muted">text-base — body</p>
          <p class="text-base text-text-muted">Aa Standard paragraph copy sits here, wrapping across a few lines to check leading.</p>
        </div>
        <div>
          <p class="mb-1 text-xs text-text-muted">text-sm — labels, secondary copy</p>
          <p class="text-sm text-text-muted">Aa Field label or card description size</p>
        </div>
        <div>
          <p class="mb-1 text-xs text-text-muted">text-xs uppercase tracking-widest — eyebrow / badge</p>
          <p class="text-xs font-semibold uppercase tracking-widest text-text-muted">Aa Eyebrow label</p>
        </div>
      </div>
    </div>
  </section>

  <!-- RADIUS SCALE -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">Radius Scale</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        Small-radius rectangles only — no <code>rounded-full</code> outside avatars and
        toggle knobs. Pick from this scale; don't introduce new one-offs.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {radiusSteps.map(r => (
          <div class="flex flex-col items-center gap-2 text-center">
            <div class={`h-16 w-16 border border-brand-500/40 bg-brand-500/10 ${r.class}`}></div>
            <span class="text-xs font-semibold text-text-primary">{r.name}</span>
            <span class="text-xs text-text-muted">{r.px} — {r.use}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BUTTONS -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">Buttons</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        <code>.btn</code> + a variant (<code>.btn-primary</code> / <code>.btn-secondary</code>)
        + a size (<code>.btn-sm</code> / <code>.btn-md</code> / <code>.btn-lg</code>). One
        focus-ring recipe baked into the base class.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a href="#" class="btn btn-primary btn-sm">Primary sm</a>
        <a href="#" class="btn btn-primary btn-md">Primary md</a>
        <a href="#" class="btn btn-primary btn-lg">Primary lg</a>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <a href="#" class="btn btn-secondary btn-sm">Secondary sm</a>
        <a href="#" class="btn btn-secondary btn-md">Secondary md</a>
        <a href="#" class="btn btn-secondary btn-lg">Secondary lg</a>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <button type="button" class="btn btn-primary btn-md" disabled>Disabled</button>
        <button type="button" class="btn-icon" aria-label="Sample icon button">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
        <span class="text-xs text-text-muted">.btn-icon — theme/language toggle, hamburger</span>
      </div>
      <p class="mt-4 text-xs text-text-muted">
        Tab to any button above to confirm the focus ring — same treatment on every variant and size.
      </p>
    </div>
  </section>

  <!-- CARDS -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">Cards</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        One <code>.card</code> recipe. Add <code>.card-link-overlay</code> on the internal
        link to make the whole card clickable without wrapping it in an anchor.
      </p>

      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <article class="card">
          <span class="badge badge-brand mb-3 self-start">3× faster</span>
          <h3 class="text-lg font-semibold text-text-primary">Card with badge</h3>
          <p class="mt-2 flex-1 text-sm text-text-muted">Metric badge uses the small-radius badge class, not a pill.</p>
          <a href="#" class="card-link-overlay mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-400">
            View case study →
          </a>
        </article>

        <article class="card hover:border-gold-500/40">
          <h3 class="text-lg font-semibold text-text-primary">Accent: gold</h3>
          <p class="mt-2 flex-1 text-sm text-text-muted">Hover border color swaps per accent — same base recipe.</p>
          <a href="#" class="card-link-overlay mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-400">
            Learn more →
          </a>
        </article>

        <article class="card hover:border-slate-500/40">
          <h3 class="text-lg font-semibold text-text-primary">Accent: slate</h3>
          <p class="mt-2 flex-1 text-sm text-text-muted">Third accent option, same card shape and motion.</p>
          <a href="#" class="card-link-overlay mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-400">
            Learn more →
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- BADGES -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">Badges</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        Always a small-radius rectangle. This replaces every <code>rounded-full</code> badge
        currently in the codebase (metric badges, eyebrow labels).
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="badge badge-brand">Brand badge</span>
        <span class="badge badge-gold">Gold badge</span>
        <span class="badge badge-slate">Slate badge</span>
        <span class="badge badge-muted">Muted tag</span>
      </div>
    </div>
  </section>

  <!-- FORM FIELDS -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-2xl font-bold text-text-primary">Form Fields</h2>
      <p class="mt-2 text-sm text-text-muted">
        Underline inputs on transparent backgrounds — the pattern already used in the
        contact form, now backed by <code>.field-label</code> / <code>.input</code>.
      </p>

      <div class="mt-6 flex flex-col gap-6">
        <div>
          <label for="sg-name" class="field-label">
            Your name<span class="ms-1 text-brand-400">*</span>
          </label>
          <input id="sg-name" type="text" placeholder="Your name" class="input" />
        </div>
        <div>
          <label for="sg-message" class="field-label">What do you need?</label>
          <textarea id="sg-message" rows="3" placeholder="Tell us what's going on" class="input"></textarea>
        </div>
        <div>
          <p class="field-label">Preferred contact method</p>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
            <button type="button" class="btn btn-secondary btn-sm border-brand-500/60 bg-brand-500/5 font-semibold text-text-primary" aria-pressed="true">Email</button>
            <button type="button" class="btn btn-secondary btn-sm" aria-pressed="false">Phone</button>
            <button type="button" class="btn btn-secondary btn-sm" aria-pressed="false">Telegram</button>
            <button type="button" class="btn btn-secondary btn-sm" aria-pressed="false">WhatsApp</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION RHYTHM -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">Section Rhythm</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        Four deliberate vertical-padding steps replace the mixed py-16 / py-20 / py-24 /
        md:py-36 seen across pages today.
      </p>
      <div class="mt-6 flex flex-col gap-4">
        {sectionRhythm.map(s => (
          <div class={`flex items-center justify-center border border-dashed border-brand-500/40 bg-brand-500/5 text-center ${s.class}`}>
            <span class="text-xs font-medium text-text-muted">
              {s.name} — {s.px} (replaces {s.replaces}) — {s.use}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MOTION -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">Motion</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        Durations mirror what's already live (200ms cards, 300ms menu) plus one new
        slower step for reveals. Hover each swatch to feel the duration.
      </p>

      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {durations.map(d => (
          <div class="flex flex-col items-center gap-2">
            <div class={`h-16 w-full rounded-sm border border-border-subtle bg-surface-900 transition-colors ${d.class} hover:bg-brand-500/20`}></div>
            <span class="text-xs font-semibold text-text-primary">{d.name}</span>
            <span class="text-xs text-text-muted">{d.ms} — {d.use}</span>
          </div>
        ))}
      </div>

      <h3 class="mt-10 text-sm font-semibold uppercase tracking-widest text-text-muted">Easing</h3>
      <p class="mt-2 max-w-2xl text-xs text-text-muted">
        <code>ease-in-out</code> is pinned to Tailwind's existing default (unchanged — the
        mobile menu already uses it). <code>ease-out</code> is new: a decelerate curve for
        entrances. Hover each bar to compare.
      </p>
      <div class="mt-4 flex flex-col gap-3">
        <div class="h-3 w-1/4 rounded-sm bg-brand-500 transition-all duration-500 ease-out hover:w-full"></div>
        <span class="text-xs text-text-muted">ease-out (--ease-out) — reveals, entrances</span>
        <div class="h-3 w-1/4 rounded-sm bg-gold-500 transition-all duration-500 ease-in-out hover:w-full"></div>
        <span class="text-xs text-text-muted">ease-in-out (--ease-in-out) — toggles, menus</span>
      </div>

      <h3 class="mt-10 text-sm font-semibold uppercase tracking-widest text-text-muted">Scroll reveal + stagger</h3>
      <p class="mt-2 text-xs text-text-muted">
        Add <code>.reveal</code>, then toggle <code>.is-visible</code> (e.g. via
        IntersectionObserver) to play the entrance once. Stagger a group with the
        <code>--reveal-delay</code> custom property (ms).
      </p>
      <div id="reveal-demo" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="reveal rounded-sm border border-border-subtle bg-surface-900 p-4 text-center text-sm text-text-muted" style="--reveal-delay: 0">Item 1</div>
        <div class="reveal rounded-sm border border-border-subtle bg-surface-900 p-4 text-center text-sm text-text-muted" style="--reveal-delay: 80">Item 2</div>
        <div class="reveal rounded-sm border border-border-subtle bg-surface-900 p-4 text-center text-sm text-text-muted" style="--reveal-delay: 160">Item 3</div>
        <div class="reveal rounded-sm border border-border-subtle bg-surface-900 p-4 text-center text-sm text-text-muted" style="--reveal-delay: 240">Item 4</div>
      </div>
      <button type="button" id="reveal-replay" class="btn btn-secondary btn-sm mt-4">Replay animation</button>
    </div>
  </section>

  <!-- RTL SAMPLE -->
  <section class="border-t border-border-subtle px-6 py-section-md">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-text-primary">RTL Sample</h2>
      <p class="mt-2 max-w-2xl text-sm text-text-muted">
        Rendered with <code>dir="rtl"</code>. Spacing uses only logical classes
        (<code>ms-</code>/<code>me-</code>/<code>ps-</code>/<code>pe-</code>) so it mirrors
        correctly — never <code>ml-</code>/<code>mr-</code>/<code>left-</code>/<code>right-</code>.
      </p>

      <div dir="rtl" class="mt-6 rounded-sm border border-border-subtle bg-surface-900 p-6">
        <nav class="flex items-center gap-6 border-b border-border-subtle pb-4">
          <span class="text-lg font-bold text-text-primary">ארגו <span class="text-brand-400">נאביס</span></span>
          <ul class="flex items-center gap-6 text-sm">
            <li><a href="#" class="focus-ring rounded-sm text-text-primary">שירותים</a></li>
            <li><a href="#" class="focus-ring rounded-sm text-text-muted">אוטומציות</a></li>
            <li><a href="#" class="focus-ring rounded-sm text-text-muted">אתרים</a></li>
          </ul>
        </nav>

        <div class="mt-5 flex items-center justify-between">
          <p class="pe-6 text-sm text-text-muted">התוכן מתחיל מצד ימין, כרווח לוגי בלבד.</p>
          <a href="#" class="group inline-flex items-center gap-1 text-sm font-medium text-brand-400">
            קרא עוד
            <svg class="h-4 w-4 rtl:rotate-180 rtl:group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <span class="badge badge-brand mt-5">תג לדוגמה</span>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Scroll-reveal demo: toggles .is-visible once each item enters the viewport.
  // "Replay" resets and re-triggers so reviewers don't have to reload to see it again.
  const items = Array.from(document.querySelectorAll("#reveal-demo .reveal"));

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
      }
    });
  }, { threshold: 0.3 });

  items.forEach((item) => observer.observe(item));

  document.getElementById("reveal-replay")?.addEventListener("click", () => {
    items.forEach((item) => {
      item.classList.remove("is-visible");
      // Force reflow so the animation can restart from scratch.
      void (item as HTMLElement).offsetWidth;
      item.classList.add("is-visible");
    });
  });
</script>
