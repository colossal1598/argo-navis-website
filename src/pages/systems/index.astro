---
/*
  PAGE GOAL: /systems service page (new). Position the custom
  management-system build — the flagship's own category — as the core,
  highest-value offer: a system shaped around the business, replacing a
  spreadsheet stack, with the fuel-distribution case study as direct
  proof. Lead source tag: "systems".

  Copy source: .apm/memory/copy/service-systems-en.md — re-read that
  file before editing any string below; it is the approved source of
  truth, not this file. Built on the Task 2.3 homepage exemplar's token
  set and motion language (py-section-*, .reveal + --reveal-delay).

  The /systems/fuel-distribution case-study page doesn't exist on this
  branch yet — it's being built in parallel (see Task Log). The link
  below is intentional per the Task Prompt and will resolve once that
  page ships; it is not a mistake if it 404s on this branch in isolation.
*/
import Layout from "../../layouts/Layout.astro";
import ProcessBlock from "../../components/ProcessBlock.astro";
import FAQBlock from "../../components/FAQBlock.astro";
import ContactForm from "../../components/ContactForm.astro";

const processSteps = [
  {
    label:       "You show us how it really works",
    description: "The spreadsheets and notebooks as they are, not the tidied-up version.",
  },
  {
    label:       "We map the real data",
    description: "A full pass over what's actually there before any schema gets built.",
  },
  {
    label:       "We build the system",
    description: "Your data migrated in, your existing tools connected, tested before handover.",
  },
  {
    label:       "You run it from your phone",
    description: "Handover plus a short walkthrough, so it sticks.",
  },
];

const faq = [
  {
    q: "Will I lose my old data?",
    a: "No. Every row you have today migrates in — nothing gets left behind in the old spreadsheet.",
  },
  {
    q: "What if my business doesn't fit standard software?",
    a: "That's exactly why we don't use standard software. The system gets built around your business, not the other way around.",
  },
  {
    q: "How long does this take?",
    a: "Depends on scope — the fuel-distribution system below took one development week. We'll scope yours honestly before starting.",
  },
];

const systemsFormFields = [
  {
    id:          "name",
    label:       "Your name",
    type:        "text" as const,
    placeholder: "Your name",
    required:    true,
  },
  {
    id:          "email",
    label:       "Email",
    type:        "email" as const,
    placeholder: "you@company.com",
    required:    true,
  },
  {
    id:          "current-setup",
    label:       "What do you use today?",
    type:        "text" as const,
    placeholder: "Excel, Morning, WhatsApp, a notebook — whatever it is",
    required:    false,
  },
  {
    id:          "message",
    label:       "What's the biggest headache right now?",
    type:        "textarea" as const,
    placeholder: "",
    required:    true,
  },
];
---

<Layout
  title="Systems"
  description="We build one system shaped around how your business actually runs — your existing data migrates in, it connects to what you already use, and it works from your phone."
>

  <!-- HERO — no CTA, let them scroll into the problem first (same convention as /automations and /websites). -->
  <section class="relative overflow-hidden bg-surface-950 px-6 py-section-lg text-start md:py-section-xl">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="reveal text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
        Every spreadsheet started as a good idea. At some point, yours became the whole operation.
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg text-text-muted" style="--reveal-delay: 80">
        We build one system shaped around how your business actually runs — your existing data migrates in, it connects to what you already use, and it works from your phone.
      </p>
    </div>
  </section>

  <!-- PROBLEM BLOCK -->
  <section class="bg-surface-900 px-6 py-section-md">
    <div class="mx-auto max-w-3xl space-y-6">
      {[
        "One person is the only one who understands the spreadsheet. What happens when they're out?",
        "The invoices are in Morning. The orders are on WhatsApp. Nobody built the bridge between them.",
        "Every new customer, every new month, means another manual entry — forever.",
      ].map((line, i) => (
        <p class="reveal text-2xl font-semibold text-text-primary md:text-3xl" style={`--reveal-delay: ${i * 80}`}>{line}</p>
      ))}
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="bg-surface-950 px-6 py-section-md">
    <div class="mx-auto max-w-3xl">
      <p class="reveal text-lg text-text-soft md:text-xl">
        We don't sell software off a shelf. We build one system around your actual business — your customers, your products, your process — and migrate everything you already have into it. Nothing gets thrown away. It connects to what you already use, and it works from a phone, because that's where you actually are.
      </p>
    </div>
  </section>

  <!--
    PROOF — the flagship case study. Real numbers only, traceable to
    .apm/memory/copy/case-study-fuel-en.md. Links to /systems/fuel-distribution
    per the Task Prompt — see the PAGE GOAL note above re: that page's status.
  -->
  <section class="border-y border-border-subtle bg-surface-900 px-6 py-section-md">
    <div class="mx-auto max-w-3xl">
      <p class="reveal badge badge-brand mb-4">Real project</p>
      <p class="reveal text-lg leading-relaxed text-text-muted" style="--reveal-delay: 60">
        We did exactly this for a family fuel-distribution business: 21 spreadsheets, replaced by one working system in a single development week, ~1,900 delivery records migrated in, running for ₪0 a month in infrastructure.
      </p>
      <a href="/systems/fuel-distribution" class="focus-ring reveal mt-4 inline-flex items-center gap-1 rounded-sm text-sm font-medium text-brand-400" style="--reveal-delay: 120">
        Read the full case study
        <svg class="h-4 w-4 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <!-- PROCESS -->
  <ProcessBlock
    heading="What working with us looks like"
    steps={processSteps}
  />

  <!-- FAQ -->
  <FAQBlock items={faq} />

  <!-- CONTACT FORM -->
  <ContactForm
    heading="Ready to see what your spreadsheets could become?"
    source="systems"
    fields={systemsFormFields}
    reassurance="We usually reply within 24 hours."
  />

</Layout>
