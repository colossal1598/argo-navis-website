---
/*
  PAGE GOAL: /websites service page. Get owners with an embarrassing or
  non-functional site into a rebuild conversation. Same lead source tag
  ("websites") as the page this replaces. The confrontational hero and
  stark problem block already pass the voice bar and are kept verbatim;
  the main change is the one real proof point the page was missing.

  Copy source: .apm/memory/copy/service-websites-en.md — re-read that
  file before editing any string below; it is the approved source of
  truth, not this file. Rebuilt on the Task 2.3 homepage exemplar's token
  set and motion language (py-section-*, .reveal + --reveal-delay).
*/
import Layout from "../../layouts/Layout.astro";
import ProcessBlock from "../../components/ProcessBlock.astro";
import FAQBlock from "../../components/FAQBlock.astro";
import ContactForm from "../../components/ContactForm.astro";

/* PROCESS STEPS — 5 steps specific to the websites service, unchanged. */
const processSteps = [
  { label: "You send us your site",  description: "Or tell us you need one from scratch" },
  { label: "We audit it",            description: "Speed, design, structure, messaging" },
  { label: "We propose a plan",      description: "Clear scope, clear price" },
  { label: "We build",               description: "You stay informed throughout" },
  { label: "You launch",             description: "With a site that actually works" },
];

const faq = [
  {
    q: "Do I need to have a site already?",
    a: "No. We build from scratch just as often as we rebuild.",
  },
  {
    q: "How long does it take?",
    a: "Depends on scope. A clean 5-page site takes 2–3 weeks. We'll tell you upfront.",
  },
  {
    q: "What do you need from me?",
    a: "Your time for one call, your logo and brand assets if you have them, and feedback when we ask for it. That's it.",
  },
];

const websiteFormFields = [
  {
    id:          "name",
    label:       "Your name",
    type:        "text" as const,
    placeholder: "Your name",
    required:    true,
  },
  {
    id:          "email",
    label:       "Email",
    type:        "email" as const,
    placeholder: "you@company.com",
    required:    true,
  },
  {
    id:          "website",
    label:       "Website",
    type:        "url" as const,
    placeholder: "yoursite.com",
    required:    false,
  },
  {
    id:          "message",
    label:       "What's the problem?",
    type:        "textarea" as const,
    placeholder: "What's not working, or what do you need?",
    required:    true,
  },
];
---

<Layout
  title="Websites"
  description="We build sites that bring people in — and rebuild ones that push them away."
>

  <!-- HERO — intentionally confrontational, kept verbatim. No CTA — let them scroll into the problem first. -->
  <section class="relative overflow-hidden bg-surface-950 px-6 py-section-lg text-start md:py-section-xl">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="reveal text-4xl font-extrabold leading-tight tracking-tight text-text-primary md:text-5xl lg:text-6xl">
        Your website is either working for you or against you. There's no middle ground.
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg text-text-muted" style="--reveal-delay: 80">
        We build sites that bring people in — and rebuild ones that push them away.
      </p>
    </div>
  </section>

  <!-- PROBLEM BLOCK — unchanged, concrete, no adjectives doing the work. -->
  <section class="bg-surface-900 px-6 py-section-md">
    <div class="mx-auto max-w-3xl space-y-6">
      {[
        "A slow site loses visitors in 3 seconds.",
        "A confusing layout kills trust before you say a word.",
        "An outdated design tells people you stopped caring.",
      ].map((line, i) => (
        <p class="reveal text-2xl font-semibold text-text-primary md:text-3xl" style={`--reveal-delay: ${i * 80}`}>{line}</p>
      ))}
    </div>
  </section>

  <!-- WHAT WE DO — includes the new proof point tying the "no bloat" promise to the flagship system's ₪0/month infra cost. -->
  <section class="bg-surface-950 px-6 py-section-md">
    <div class="mx-auto max-w-3xl">
      <p class="reveal text-lg text-text-soft md:text-xl">
        We build clean, fast websites that do one thing —{" "}
        <strong class="text-text-primary">turn visitors into leads.</strong>{" "}
        No bloat, no templates that look like everyone else's.
      </p>

      <ul class="mt-8 space-y-3">
        {[
          "Fast and mobile-first",
          "Built to rank on Google",
          "Designed around your customer, not your preferences",
        ].map((line, i) => (
          <li class="reveal flex items-start gap-3 text-text-muted" style={`--reveal-delay: ${80 + i * 60}`}>
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-xs bg-brand-400"></span>
            {line}
          </li>
        ))}
      </ul>

      <!-- PROOF POINT — the fact this page was missing per the copy file. -->
      <p class="reveal mt-8 text-text-muted" style="--reveal-delay: 260">
        The same zero-lock-in approach we use to run a client's entire business system for ₪0 a month in infrastructure costs applies to a website too — no bloated monthly hosting fee, no vendor you can't leave.
      </p>
    </div>
  </section>

  <!-- PROCESS -->
  <ProcessBlock
    heading="What working with us looks like"
    steps={processSteps}
  />

  <!-- REBUILD OFFER — freshened body copy, less of a stock phrase; unchanged structure/CTA target. -->
  <section id="rebuild" class="bg-surface-800 px-6 py-section-lg">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="reveal text-3xl font-bold text-text-primary md:text-4xl">
        We'll show you what your site could look like. Before you commit to anything.
      </h2>
      <p class="reveal mx-auto mt-5 max-w-xl text-text-muted" style="--reveal-delay: 80">
        Send us your site. We'll come back with a real example of what we'd change — no obligation either way.
      </p>
      <a href="#contact" class="reveal btn btn-primary btn-lg mt-8" style="--reveal-delay: 160">
        Show us your site
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <FAQBlock items={faq} />

  <!-- CONTACT FORM -->
  <ContactForm
    heading="Got a site that's not doing its job? Tell us."
    source="websites"
    fields={websiteFormFields}
    reassurance="We usually reply within 24 hours."
  />

</Layout>
